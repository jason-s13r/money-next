# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# LLM inference transcripts left over from before a run logged itself into a chat
# thread — they contain raw transaction data, so keep ignoring them
budget-inference-*.log
logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example
money.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# classifier rule seed — names your employer, your banks, and you.
# The ClassificationRule table (in the ignored database) is the source of truth.
classify.rules.json

# prisma
# the sqlite database holds personal financial data — never commit it
*.db
*.db.*
*.db-journal
*.db-wal
*.db-shm
# generated prisma client, recreated by `pnpm db:generate`
/lib/generated/
.claude/
.pnpm-store/
*.dump
/logs/

# vendored agent skill docs — third-party, not ours to redistribute
.agents/
skills-lock.json

# internal working notes, not part of the published project
internal/
