# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — pnpm only (see pnpm-workspace.yaml / pnpm-lock.yaml)
/node_modules
/.pnpm-store/

# next.js
/.next/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
.pnpm-debug.log*

# LLM inference transcripts left over from before a run logged itself into a chat
# thread — they contain raw transaction data, so keep ignoring them
budget-inference-*.log
logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example
# deploy/quadlet/money.env — the filled-in copy of money.env.example
money.env

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
# generated client, recreated by `pnpm db:generate`
/lib/generated/
# pg_dump output — a dump of this database is the whole financial history
*.dump

# local tooling
.claude/

# vendored agent skill docs — third-party, not ours to redistribute
.agents/
skills-lock.json

# internal working notes, not part of the published project
internal/
