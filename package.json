{
  "name": "money-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bin/with-env node --import tsx --test tests/*.test.ts",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait",
