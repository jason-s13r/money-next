    "db:studio": "prisma studio",
    "worker:start": "bin/with-env tsx scripts/worker.ts",
    "money:cli": "./bin/money"
  },
  "bin": {
    "money": "./bin/money"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "dependencies": {
