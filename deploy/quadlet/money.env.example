# Copy to money.env in this directory, fill in, then run ./install.sh.
# install.sh copies this to ~/.config/money/money.env (chmod 600) and derives the
# three per-role DATABASE_URL env files from the passwords below. Nothing here is
# baked into an image — it is read at container start.
#
# Passwords may contain any characters: install.sh percent-encodes them when it
# composes the DATABASE_URLs, so URL-reserved bytes ('/' and '+' from
# `openssl rand -base64`, '@', ':', '#', '?', spaces) are safe. The one caveat is
# systemd's EnvironmentFile parser, which reads these lines verbatim: avoid a
# leading '#' and embedded quotes or newlines — none of which base64 produces.

# --- Postgres owner (migrate connects as this; owns the schema, runs DDL) ---
# If you restored a dev pg_dumpall, set POSTGRES_PASSWORD to the DEV owner
# password — the dump reset it — otherwise migrate can't authenticate.
POSTGRES_USER=money
POSTGRES_PASSWORD=
POSTGRES_DB=money

# --- Least-privileged RLS runtime roles (migrate's db:roles sets these) ---
# app connects as money_app, worker/cron as money_sync.
APP_DB_PASSWORD=
SYNC_DB_PASSWORD=

# --- App ---
# Signs session tokens. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The real external origin the app is served on (behind your reverse proxy).
# Better Auth judges same-origin against this — it must be the URL you browse to.
# Using plain http on a trusted LAN? Set this to the http:// URL — Better Auth
# then drops the Secure flag on session cookies automatically, and set
# INSECURE_HTTP=1 below so the CSP stops upgrading requests to https.
BETTER_AUTH_URL=https://money.your-lan.example
# Set to 1 only for a plain-http LAN deployment with no TLS. Drops
# `upgrade-insecure-requests` from the CSP, which would otherwise rewrite every
# subresource to https:// and fail, and suppresses HSTS, which would otherwise
# lock the browser to a scheme this origin cannot answer on. Leave empty for any
# https deployment.
INSECURE_HTTP=
# "true" forces TOTP enrolment; anything else leaves it optional.
REQUIRE_MFA=
# Namespace for app-minted ids. Optional; defaults to "app".
ID_NAMESPACE=

# --- Akahu — https://my.akahu.nz ---
# The instance-wide pair, used by any bank link whose tokenSource is `env`. One
# pair serves one person's accounts; a second workspace wants `money link token`.
AKAHU_APP_ID_TOKEN=
AKAHU_USER_ACCESS_TOKEN=
# Encrypts tokens stored per-link by `money link token`. Generate:
# openssl rand -base64 32. Leave empty if every link uses the env pair above.
# money-worker gets this; money-app and money-cron deliberately do not (both
# blank it in their .container — the web role never calls Akahu, and an enqueuer
# never opens a token). Never put this in the database it opens: that is what
# makes a stolen dump inert.
TOKEN_ENCRYPTION_KEY=
# The keypair behind the app's "connect a bank" form — `money link keypair` prints
# both. money-app gets the public half only: it lets the form store a token the
# web service can never read back. money-worker gets the private half, which is
# what opens one; money-app.container and money-cron.container blank it on
# purpose. `money link upgrade` converts existing TOKEN_ENCRYPTION_KEY rows to
# this scheme, after which that key can be dropped.
TOKEN_PUBLIC_KEY=
TOKEN_PRIVATE_KEY=

# --- Email (optional) ---
# Leave SMTP_HOST empty and invites and password resets stay copyable links,
# handed over by whoever generated them. Set it and the same links are emailed as
# well; the copyable link remains either way, so a send that fails is recoverable.
#
# money-worker sends. money-app composes the message and writes it to a queue it
# cannot read back, and money-cron sends nothing — both blank SMTP_PASSWORD in
# their .container, the same arrangement as the Akahu keys. Only the password:
# the app needs SMTP_HOST to know whether what it queues will really be delivered.
#
# Links in these emails come from BETTER_AUTH_URL above, since a message composed
# on the server has no browser origin to borrow. Get it wrong and you mail a
# working reset link to a host you do not control.
SMTP_HOST=
# 465 for implicit TLS, 587 for STARTTLS. Encryption follows the port.
SMTP_PORT=465
# Usually the full email address (Fastmail requires it). Both this and the
# password are optional — a relay on the host may want no authentication.
SMTP_USER=
# An app-specific password, never the account password, scoped to SMTP alone if
# the provider allows: then a leak of this file sends mail rather than reading it.
SMTP_PASSWORD=
# The From: header, which is not the login — most providers reject a From they
# have not verified. Optional; defaults to SMTP_USER. Accepts a display name.
SMTP_FROM=
# SMTP_SECURE overrides the port's convention, for a relay that disagrees with it.
# See .env.example in the repo root.

# --- The local model (optional) ---
# Powers the budget inference (in money-worker) and the chat (in money-app), both
# of which read this same file. Leave LLM_API empty and the budget button falls
# back to the deterministic seeder and the chat is not offered.
#
# LOCAL ONLY: the prompt is this household's whole transaction history. A
# non-loopback, non-private address is refused unless LLM_ALLOW_REMOTE=true.
#
# Note the pod. Every container here shares ONE network namespace (money.pod), so
# 127.0.0.1 is the *pod's* loopback — a model running on the host is reached at
# host.containers.internal:11434, not 127.0.0.1. Both spellings pass the locality
# check; only one of them resolves.
LLM_API=
# Bearer token, only if the endpoint wants one. Ollama does not.
LLM_API_KEY=
# Which model to ask for. Default llama3.1.
LLM_MODEL=
# See .env.example in the repo root for the tuning knobs (LLM_TIMEOUT,
# LLM_MAX_STEPS, LLM_MAX_TOOL_ROWS, LLM_MAX_MONTHS, LLM_CONTEXT_TOOL_BUDGET) and
# for the worker queue's (WORKER_POLL_SECONDS and friends). All optional.

# --- Container plumbing ---
# Host port the app is published on.
APP_PORT=3000
# How often money-cron *enqueues* a sync, in seconds (default 6h). money-worker
# is what runs it — with the worker stopped, syncs queue and never happen.
SYNC_INTERVAL_SECONDS=21600
