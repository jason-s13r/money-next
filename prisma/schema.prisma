// Personal finance data, ingested from the Akahu API.
//
// Akahu ids are primary keys, so re-running a sync is idempotent.
//
// Money is `Decimal @db.Decimal(19, 4)`, never `Float`: sums must be exact.
// Prisma returns decimal.js objects, converted to numbers at the query boundary.
// Rates are ratios rather than money and stay `Float`.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
//
// The tenant is a `Workspace`. Financial data hangs off a workspace, never off a
// user: a solo user is a workspace with one member and a shared one has two, so
// the query layer can't tell the difference and doesn't need to.
// ---------------------------------------------------------------------------

/// A tenant: the thing financial data belongs to, and the unit of sharing.
model Workspace {
  id   String @id @default(cuid())
  name String
  /// URL-safe identity, unique across the instance. Routes are keyed on it,
  /// which keeps any future cache key workspace-specific for free.
  slug String @unique

  /// Better Auth's organization plugin declares both and its endpoints write
  /// them. Neither is rendered anywhere: the library's columns, not a feature
  /// this app has decided to have.
  logo     String?
  metadata String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members   Membership[]
  invites   Invite[]
  bankLinks BankLink[]

  // Every tenant-owned table, related rather than left as a loose column, so
  // deleting a workspace cascades to its financial data in one statement.
  // Akahu's accreditation and the Privacy Act require deletion on request to be
  // real, so "delete a workspace" must never become a soft delete.
  accounts                Account[]
  transactions            Transaction[]
  pendingTransactions     PendingTransaction[]
  balanceSnapshots        BalanceSnapshot[]
  transferGroups          TransferGroup[]
  conflicts               TransactionConflict[]
  merchants               Merchant[]
  labels                  Label[]
  transactionLabels       TransactionLabel[]
  budgets                 Budget[]
  budgetItems             BudgetItem[]
  budgetInferenceRuns     BudgetInferenceRun[]
  ruleDocuments           RuleDocument[]
  ruleRuns                RuleRun[]
  fieldChanges            FieldChange[]
  syncStates              SyncState[]
  syncRuns                SyncRun[]
  chatThreads             ChatThread[]
  chatMessages            ChatMessage[]
}

/// A person. Deliberately minimal, and named to match the core fields Better
/// Auth expects, which is why it adopted this table with no rename: Better Auth
/// owns authentication (credentials, sessions, MFA), and this app only ever
/// needs the identity a `Membership` points at.
model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  /// Whether TOTP is enrolled. Whether it is *required* is `REQUIRE_MFA`, not a
  /// column. Nullable because Better Auth's twoFactor plugin declares it so.
  twoFactorEnabled Boolean? @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sessions       Session[]
  authAccounts   AuthAccount[]
  twoFactors     TwoFactor[]
  memberships    Membership[]
  invitesSent    Invite[]      @relation("InviteInvitedBy")
  bankLinksAdded BankLink[]
  // `SetNull` on the other side, unlike everything else hanging off a workspace:
  // deleting a person drops the claim about who made an edit, not the record
  // that it happened.
  fieldChanges   FieldChange[]
  // Cascade instead: a thread is one person's conversation and nobody else can
  // read it, so nothing is left to preserve once they are gone.
  chatThreads    ChatThread[]
  // `SetNull` again: the run is work done to the household's budgets, and
  // outlives the claim about who asked for it.
  inferenceRuns  BudgetInferenceRun[]
}

// ---------------------------------------------------------------------------
// Authentication
//
// Better Auth's tables, under this schema's names. Nothing in the app reads them
// directly; they are the library's, reached through the auth layer.
//
// Their shape is not ours to design: it is `@better-auth/cli generate` output,
// reconciled with the conventions here (`Timestamptz(3)`, no `@@map`). If an
// upgrade wants a column, re-run the CLI and diff rather than guessing.
// ---------------------------------------------------------------------------

/// A logged-in session. Better Auth owns the token and the expiry; membership is
/// re-validated per request, which is what makes a revoked membership take
/// effect on the next request rather than at expiry.
model Session {
  id        String   @id @default(cuid())
  /// The session cookie's value. Unique: looked up on every request.
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)

  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The organization plugin's "active organization", in our vocabulary. Nothing
  /// reads it: the workspace is in the URL and membership is re-checked per
  /// request, so a session carrying one would be a second, staler answer to a
  /// question the path already asks. Present because the plugin writes it.
  activeWorkspaceId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// A credential, or a linked identity at an OAuth provider.
///
/// Better Auth calls this `account`. This schema's `Account` is a *bank* account
/// and was here first, so the model is renamed and the auth mapping
/// (`account: { modelName: "authAccount" }`) points the library at it.
///
/// `password` holds a hash, never a password — Better Auth owns the hashing.
model AuthAccount {
  id String @id @default(cuid())

  /// The id at the provider; for credentials, the user's own id.
  accountId  String
  /// `credential` for email+password, else the OAuth provider's name.
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// Short-lived tokens Better Auth issues for email verification and password
/// reset. Transient; nothing here refers to them.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

/// A user's TOTP enrolment: the shared secret and their backup codes. The
/// highest-value rows in the auth tables: the secret is a second factor at rest.
model TwoFactor {
  id String @id @default(cuid())

  secret      String
  backupCodes String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Set false while enrolment is mid-flight, true once a code has been proven.
  verified Boolean? @default(true)

  /// Better Auth's own lockout on repeated failed challenges.
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
}

/// A user's place in a workspace, and what they may do there. Many-to-many: a
/// user can belong to and create several workspaces. Any limit on that is a
/// check inside `createWorkspace`/`acceptInvite` — the only two places a
/// membership is born — not a schema reshape.
///
/// Better Auth's organization plugin calls this `member` and owns its writes.
model Membership {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// owner | editor | viewer. A plain string, matching this schema's no-enums
  /// style, and enforced at the write boundary rather than only in the UI.
  /// Adding a role is a new string plus its place in the ordering, not a
  /// migration.
  role String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// One membership per user per workspace; the role is a field, not a second row.
  @@unique([workspaceId, userId])
  @@index([userId])
}

/// A pending invitation to join a workspace. Redeeming one is the other entry
/// point (with `createWorkspace`) for a new membership.
///
/// No `token` column, deliberately: the link carries the invite's *id*, and
/// `acceptInvitation` requires a session, then refuses unless `email` matches
/// the logged-in user's, the row is still `pending`, and `expiresAt` is in the
/// future — flipping the status with a compare-and-set so redemption is
/// atomically single-use.
///
/// The id is therefore an identifier and not a capability; being logged in as
/// the invited person is. A forwarded link is useless to whoever receives it.
model Invite {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Who it was addressed to, and the role they get on acceptance. Checked
  /// against the session's email, so `email` is a control, not a label.
  email String
  role  String

  /// The invitee's name, if the owner typed one when sending the invite. A
  /// convenience that pre-fills the signup form, never a control: the invitee
  /// can change it, and Better Auth's `createInvitation` doesn't set it, so an
  /// invite made any other way simply has none.
  name String?

  /// pending | accepted | rejected | canceled. Transitioned out of `pending`
  /// exactly once, which is what makes an invite single-use.
  status String @default("pending")

  invitedByUserId String?
  invitedBy       User?   @relation("InviteInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([workspaceId])
  @@index([email])
}

/// A workspace's connection to Akahu — the thing accounts are ingested through,
/// and the unit a user revokes.
///
/// `status`/`revokedAt` are what Akahu's accreditation requires an app to expose
/// to consumers, so they are modelled here rather than derived.
model BankLink {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// What the user calls this connection.
  name String

  /// ACTIVE | INACTIVE (Akahu stopped refreshing it) | REVOKED (access withdrawn,
  /// here or at Akahu). Ingest only runs for ACTIVE links.
  status String @default("ACTIVE")

  /// Set when access ends, whichever side ended it. Distinct from deletion: a
  /// revoked link stops syncing, but its already-ingested history remains until
  /// the workspace is deleted.
  revokedAt DateTime? @db.Timestamptz(3)

  /// Where this link's Akahu credentials come from.
  ///
  /// `env`    — the AKAHU_APP_ID_TOKEN / AKAHU_USER_ACCESS_TOKEN pair. One
  ///            instance-wide pair, so at most one link can meaningfully use it.
  /// `stored` — the encrypted columns below: a personal token from my.akahu.nz
  ///            held per link, so a second workspace can sync a second person's
  ///            accounts without sharing a token.
  ///
  /// A source *name* rather than a boolean, leaving room for an `oauth` value on
  /// the same two columns: how a credential arrived decides what may be done
  /// with it (`auth.revoke()` applies to a grant, not to a personal token).
  tokenSource String @default("env")

  /// AES-256-GCM ciphertext, never the token itself. The key lives in
  /// TOKEN_ENCRYPTION_KEY — in the sync worker's and the CLI's environment, and
  /// deliberately *not* the web app's. It is never in this database, which is
  /// what makes a stolen dump inert.
  ///
  /// Each blob is bound to this row and this field as additional authenticated
  /// data, so a ciphertext moved to another link — or from the app slot to the
  /// user slot — fails to decrypt rather than silently authenticating as someone
  /// else's connection.
  appTokenCipher  String?
  userTokenCipher String?

  /// When the stored pair was last set: the credential's own age, where
  /// `updatedAt` moves whenever anything here changes.
  tokenUpdatedAt DateTime? @db.Timestamptz(3)

  /// Who connected it. Null for the bootstrap link, which predates users.
  connectedByUserId String?
  connectedBy       User?   @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  accounts  Account[]
  syncState SyncState?
  syncRuns  SyncRun[]

  @@index([workspaceId, status])
}

/// A connected financial account, mirrored from Akahu's `/accounts`.
model Account {
  /// Akahu account id, e.g. `acc_...`
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The Akahu connection this account was ingested through. Restrict, not
  /// Cascade: unlinking a bank must be a deliberate decision about the history,
  /// not a silent shredding of it.
  bankLinkId String
  bankLink   BankLink @relation(fields: [bankLinkId], references: [id], onDelete: Restrict)

  name             String
  /// ACTIVE | INACTIVE
  status           String
  /// CHECKING | SAVINGS | CREDITCARD | LOAN | KIWISAVER | ...
  type             String
  formattedAccount String?

  /// The institution the account is held at.
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  /// Account holder name as exposed by the provider, when available.
  holder String?

  /// Akahu's TRANSACTIONS, PAYMENT_TO and PAYMENT_FROM capabilities.
  hasTransactions     Boolean @default(false)
  canReceivePayments  Boolean @default(false)
  canInitiatePayments Boolean @default(false)

  /// Latest balance, flattened from `balance`. Absent for some account types.
  currency         String?
  balanceCurrent   Decimal? @db.Decimal(19, 4)
  balanceAvailable Decimal? @db.Decimal(19, 4)
  balanceLimit     Decimal? @db.Decimal(19, 4)
  overdrawn        Boolean?

  /// When Akahu last refreshed each part of the account data.
  refreshedBalance      DateTime? @db.Timestamptz(3)
  refreshedMeta         DateTime? @db.Timestamptz(3)
  refreshedTransactions DateTime? @db.Timestamptz(3)
  refreshedParty        DateTime? @db.Timestamptz(3)

  /// When Akahu last refreshed the account, distinct from when we last synced it.
  refreshedAt DateTime? @db.Timestamptz(3)
  syncedAt    DateTime  @updatedAt @db.Timestamptz(3)

  transactions Transaction[]
  pending      PendingTransaction[]
  balances     BalanceSnapshot[]

  @@index([status])
  @@index([connectionId])
}

/// A financial institution, built from the `connection` object embedded in each
/// Akahu account.
model Connection {
  /// Akahu connection id, e.g. `conn_...`
  id             String  @id
  name           String
  /// URL of the institution's logo.
  logo           String?
  /// classic | official
  connectionType String

  accounts     Account[]
  transactions Transaction[]
  pending      PendingTransaction[]

  syncedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([connectionType])
}

/// A settled transaction, mirrored from Akahu's `/transactions`.
/// Enriched fields (merchant, category, meta) are only present on enriched
/// transactions, so they are all nullable.
model Transaction {
  /// Akahu transaction id, e.g. `trans_...`
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  date        DateTime @db.Timestamptz(3)
  description String
  /// Negative for money out, positive for money in.
  amount      Decimal  @db.Decimal(19, 4)
  /// Account balance after this transaction, when the institution reports it.
  balance     Decimal? @db.Decimal(19, 4)
  /// DEBIT | CREDIT | TRANSFER | EFTPOS | FEE | ...
  type        String
  hash        String?

  merchantId      String?
  merchant        Merchant?      @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// The `personal_finance` spending group this row sits under: an NZFCC
  /// `group_...`, or an invented `group_custom_...` income group. A column rather
  /// than a value derived through the category, because an uncategorised inflow
  /// still carries an income group with no category, and because metrics
  /// `groupBy` it (Prisma can't group across a relation). The group *name* lives
  /// only on `CategoryGroup`.
  categoryGroupId String?
  categoryGroup   CategoryGroup? @relation(fields: [categoryGroupId], references: [id], onDelete: SetNull)

  /// Who owns the enrichment, per editable field: `akahu` (mirrored, and the
  /// sync may overwrite it) or `user` (hand-set, so a sync that disagrees
  /// records a `TransactionConflict` rather than clobbering it).
  categorySource String @default("akahu")
  merchantSource String @default("akahu")

  particulars  String?
  code         String?
  reference    String?
  otherAccount String?
  cardSuffix   String?

  /// Set when the transaction was made in another currency. The rate is a ratio
  /// rather than money, so it stays `Float`.
  conversionAmount   Decimal? @db.Decimal(19, 4)
  conversionCurrency String?
  conversionRate     Float?

  /// URL of a merchant logo image for this transaction, when Akahu provides one.
  logo String?

  /// The transfer this row is one leg of. A group holds two *or more* legs, so it
  /// spans not just a simple out/in pair but a multi-currency conversion and a
  /// separate fee row too, and "is this a transfer" is a `transferGroupId: null`
  /// test on either leg. Always user-made: Akahu tags a row's `type` as TRANSFER
  /// but never says which rows belong together.
  transferGroupId String?
  transferGroup   TransferGroup? @relation(fields: [transferGroupId], references: [id], onDelete: SetNull)

  /// Timestamps as reported by Akahu, not by us.
  createdAt DateTime? @db.Timestamptz(3)
  updatedAt DateTime? @db.Timestamptz(3)
  syncedAt  DateTime  @default(now()) @db.Timestamptz(3)

  // A transaction's nature is derived, not stored: money in (`amount > 0`) is
  // income; money out (`amount < 0`) is spending, categorised when Akahu supplied
  // a `categoryGroup` and uncategorised otherwise. No classifier writes here.

  conflicts TransactionConflict[]
  /// Free-form user tags, through the explicit `TransactionLabel` join.
  labels    TransactionLabel[]

  // The prefix of nearly every metrics query: workspace before anything else.
  @@index([workspaceId, date])
  @@index([accountId, date])
  @@index([date])
  @@index([categoryGroupId])
  @@index([categoryId])
  @@index([merchantId])
  @@index([transferGroupId])
  @@index([connectionId])
  // Trigram indexes for the free-text search, which runs as ILIKE '%term%' and
  // so can use no btree index. Declared here rather than as raw SQL in the
  // migration, or `migrate dev` reads them as drift and offers to drop them.
  // Every column the search ORs over is indexed: Postgres only combines OR
  // branches into a BitmapOr when each one has an index.
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transaction_description_trgm_idx")
  @@index([particulars(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transaction_particulars_trgm_idx")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transaction_code_trgm_idx")
  @@index([reference(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transaction_reference_trgm_idx")
  @@index([otherAccount(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transaction_otherAccount_trgm_idx")
}

/// A pending (authorised but not-yet-settled) transaction, mirrored from Akahu's
/// `/transactions/pending`. These have no stable id: a pending row vanishes once
/// it settles — reappearing under a real `trans_...` id with no back-reference —
/// or is cancelled, so each sync *replaces* this whole table with Akahu's current
/// pending set rather than upserting by id. Display-only, and kept out of every
/// balance, spend, runway and rules path: pending money is not settled money.
/// Akahu attaches no merchant or category here, so those columns are absent.
model PendingTransaction {
  id Int @id @default(autoincrement())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  date        DateTime @db.Timestamptz(3)
  description String
  /// Negative for money out, positive for money in.
  amount      Decimal  @db.Decimal(19, 4)
  /// DEBIT | CREDIT | TRANSFER | EFTPOS | FEE | ...
  type        String

  /// Akahu's `updated_at`. Pending rows carry no `created_at`.
  akahuUpdatedAt DateTime @db.Timestamptz(3)

  particulars  String?
  code         String?
  reference    String?
  otherAccount String?
  cardSuffix   String?

  conversionAmount   Decimal? @db.Decimal(19, 4)
  conversionCurrency String?
  conversionRate     Float?

  syncedAt DateTime @default(now()) @db.Timestamptz(3)

  // Each sync replaces this table one workspace at a time, so the workspace is
  // both the read prefix and the delete predicate.
  @@index([workspaceId, date])
  @@index([accountId, date])
  @@index([date])
}

/// A user-defined grouping of transactions that together make up one internal
/// transfer: the outflow and inflow legs, plus any currency-conversion or fee
/// rows. Its legs are excluded from income/spend/net metrics. Akahu never links
/// the legs itself, so every group here is hand-made.
model TransferGroup {
  /// A cuid, not a counter: a sequential id would publish how many transfers
  /// exist across every workspace on the instance, and could be walked. Scoping
  /// makes a guessed id return nothing; this leaves nothing to guess.
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  transactions Transaction[]

  @@index([workspaceId])
}

/// Historical daily FX reference rates from the ECB, fetched via frankfurter.dev
/// during a sync and cached so cross-currency transfer matching runs offline like
/// every other read here. `rate` is units of `currency` per 1 unit of `base` on
/// `date` (the base is stored as 1); convert A→B with `amount * rateB / rateA`,
/// which is base-agnostic. Quoted against NZD, so the common NZD↔X pair is a
/// single lookup. The ECB only publishes on business days, so a weekend or
/// holiday transaction reads the most recent prior date.
model FxRate {
  date     DateTime @db.Timestamptz(3)
  base     String
  currency String
  rate     Float

  @@id([date, base, currency])
  @@index([base, currency, date])
}

/// A divergence between a user-set enrichment field and what a later Akahu sync
/// reported for it. Raised only when a `user`-owned field receives a *different,
/// non-null* value from Akahu — an inflow Akahu simply leaves uncategorised never
/// conflicts. The kept value is the user's; this row is the prompt to reconcile.
model TransactionConflict {
  id Int @id @default(autoincrement())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  /// Which enrichment field diverged: `category` | `merchant`.
  field String

  /// What owns the value being kept: `user` (someone set it by hand) or `rule`
  /// (their rules set it). Both outrank Akahu and both can therefore diverge
  /// from it, but "you set this" and "your rule set this" call for different
  /// fixes.
  heldSource String @default("user")

  /// The value being kept, for display without a join. Named `userValue*` from
  /// when the user was the only owner the sync deferred to.
  userValueId     String?
  userValueLabel  String?
  /// The value Akahu reported on the sync that raised this, for a side-by-side.
  akahuValueId    String?
  akahuValueLabel String?

  /// `open` (awaiting the user) | `dismissed` (they kept theirs; don't re-nag
  /// unless Akahu's value changes again).
  status String @default("open")

  detectedAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  // One live conflict per field per transaction: a new sync updates it in place
  // rather than stacking duplicates.
  @@unique([transactionId, field])
  @@index([status])
}

/// A merchant, mirrored from Akahu's transaction enrichment. One `merchant`
/// object recurs across thousands of transactions, so it is stored once here and
/// referenced by `Transaction.merchantId` rather than copied onto every row.
model Merchant {
  /// Akahu merchant id, e.g. `merchant_...`
  id String @id

  /// The one table that is half catalog, half tenant data.
  ///
  /// `null` = Akahu's global merchant catalog (`merchant_...`), shared by every
  /// workspace. Set = a private merchant a user minted here (`user_...`) from a
  /// name they typed, which is their data and nobody else's.
  ///
  /// So reads OR the two together and creates always stamp the workspace: the
  /// one model where the scoped client cannot simply inject an equality filter.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String
  /// The merchant's website, when Akahu resolved one.
  website String?
  /// URL of a logo image for this merchant, when Akahu provides one.
  logo    String?

  transactions Transaction[]
  budgetItems  BudgetItem[]

  // A business can arrive under more than one Akahu id, so the name is indexed
  // for lookup, not constrained.
  @@index([name])
  // The search matches merchant names through a relation filter; same trigram
  // reasoning as `Transaction`.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Merchant_name_trgm_idx")
}

/// A free-form tag a workspace attaches to its transactions — the user's own
/// grouping ("reimburse", "tax-deductible") alongside the merchant and category
/// the bank enrichment supplies. Nothing about a label is mirrored from Akahu, so
/// unlike merchant/category it carries no `*Source`, raises no
/// `TransactionConflict`, and a sync never touches it.
model Label {
  /// Minted here (`app_label_...`) from a name someone typed. Never mirrored, so
  /// it never shares an id with an Akahu row.
  id String @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  transactions TransactionLabel[]

  // One label per name within a workspace, so the picker's "create" reuses an
  // existing tag rather than minting a duplicate.
  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// The many-to-many join between `Transaction` and `Label`. Explicit rather than
/// Prisma's implicit m-n because the join row must carry its own `workspaceId`
/// for the RLS policy to scope it, and an implicit join table has no column the
/// policy could read. Both sides cascade: deleting a transaction or a label
/// removes the tag, never orphans it.
model TransactionLabel {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([transactionId, labelId])
  @@index([workspaceId])
  @@index([labelId])
}

/// A `personal_finance` spending group (or an invented income group), stored once
/// and referenced by both `Category` and `Transaction` rather than having its name
/// copied onto every row. Populated at ingest from the NZFCC mirror and, as a
/// safety net, from each transaction's enrichment.
model CategoryGroup {
  /// Real NZFCC `group_...` id, or an invented `group_custom_...` income group id.
  id   String @id
  name String

  categories   Category[]
  transactions Transaction[]
  budgetItems  BudgetItem[]
}

/// The NZFCC category catalog, mirrored from nzfcc.org so an `nzfcc_...` id
/// resolves to its name and spending group locally. Refreshed on every sync, so a
/// category the standard adds appears the next run.
model Category {
  /// NZFCC category id, e.g. `nzfcc_...`
  id        String @id
  name      String
  /// debit (spending) | credit (income)
  direction String

  /// The `personal_finance` group. NZFCC leaves this absent on credit categories,
  /// so the catalog fills those with a custom income group to match the group on
  /// inflows. The group name lives on `CategoryGroup`.
  groupId String?
  group   CategoryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  budgetItems  BudgetItem[]

  syncedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([groupId])
  // The search matches category names through a relation filter; same trigram
  // reasoning as `Transaction`.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Category_name_trgm_idx")
}

// ---------------------------------------------------------------------------
// Budgets
//
// Everything above this line records what happened. These models are the only
// ones that describe what is *meant* to happen, and nothing here is mirrored from
// Akahu: a budget is entirely the user's, like `Label`.
//
// The shape is deliberately the mirror image of `Transaction`. A `BudgetItem` is
// an intended transaction — signed amount, category group, optional category and
// merchant — plus a recurrence. Expanding that recurrence yields dates, and
// bucketing those dates with the same `periodKey` the metrics use puts plan and
// actual in identical buckets, which is what lets the budget breakdown reuse the
// historic comparison's types, row tree and components whole.
// ---------------------------------------------------------------------------

/// A named plan, and the span over which it applies.
///
/// The lifespan is what makes one model carry three quite different things: a
/// general daily-living budget (no bounds, always on), a Christmas budget (a
/// window, repeating every year), and a one-off holiday trip (a window, once).
///
/// Budgets *layer*, but explicitly rather than by coincidence. A budget is either
/// a **base** — the ongoing plan, `baseBudgetId` null — or a **layer** of exactly
/// one base, holding only the *extra* a period needs. A seasonal Christmas layer
/// therefore describes what is spent on top of ordinary life, not instead of it,
/// and is added to its base precisely while its own window is live. The breakdown
/// and every forecast expand a base together with its date-active layers; nothing
/// sums two unrelated budgets, which is what makes the addition safe. One level
/// only — the create/move actions enforce that, since the schema cannot.
model Budget {
  /// A cuid, not a counter — it *is* the address of the budget, in the URL and in
  /// every link to it, and a sequential id would publish how many budgets exist
  /// across every workspace on the instance.
  ///
  /// Deliberately no slug: a budget is not a shared or indexed page, so a copy of
  /// the name taken at creation buys no readability and goes stale on the first
  /// rename.
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// What the household calls it. Not unique and not a key: two "Christmas"
  /// layers on two different bases is an ordinary thing to have.
  name String

  /// The span this budget applies over, as NZ calendar days and **inclusive of
  /// both ends** — "active until 25 December" includes the 25th. Timestamptz like
  /// every other date here, with the day it names resolved in Pacific/Auckland.
  ///
  /// Both null is the general, always-on budget. Both set is a seasonal or event
  /// budget. One of each is a valid half-bounded window ("from March onwards").
  startsOn DateTime? @db.Timestamptz(3)
  endsOn   DateTime? @db.Timestamptz(3)

  /// Whether the window repeats every year. When set, only the month and day of
  /// `startsOn`/`endsOn` matter and the year is ignored — including when the span
  /// wraps the New Year (15 Dec – 5 Jan), which the active-on test handles
  /// explicitly. Meaningless, and ignored, on an open-ended window.
  repeatsAnnually Boolean @default(false)

  /// Where this budget came from: `user` (someone made it) or `inferred` (the
  /// seeder built it from transaction history). Provenance, never a control —
  /// nothing branches on it for correctness. It is how "re-infer from history"
  /// finds the budget to refresh, and how the UI can say a figure was guessed.
  origin String @default("user")

  /// Whether this budget is one of the forward projections drawn on the dashboard
  /// and runway tiles. A base marked `forecast` is walked forward day by day
  /// together with its date-active layers; layers are never forecast roots, and
  /// the projection's name and colour come from the budget itself.
  forecast Boolean @default(false)

  /// The base this budget layers onto, or null when it *is* a base. A layer holds
  /// only the extra spend a period needs, added on top of its base; base + active
  /// layers is what the breakdown and every forecast project. `Cascade`: a layer
  /// is meaningless once its base is gone. One level only — the create/move
  /// actions refuse to point a layer at another layer.
  baseBudgetId String?
  base         Budget?  @relation("BudgetLayers", fields: [baseBudgetId], references: [id], onDelete: Cascade)
  layers       Budget[] @relation("BudgetLayers")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  items          BudgetItem[]
  inferenceRuns  BudgetInferenceRun[]

  // Every projection starts here: this workspace's budgets, narrowed to the ones
  // whose window could overlap the span being drawn.
  @@index([workspaceId, startsOn, endsOn])
  // A base's layers, and the "bases only" filter the pickers use.
  @@index([workspaceId, baseBudgetId])
}

/// One intended transaction: an amount, a recurrence, and where it is filed.
model BudgetItem {
  id String @id @default(cuid())

  /// Carried on the row itself even though the item is reachable through its
  /// budget: the RLS policy is a predicate on a column, and cannot follow a
  /// relation to find one.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  /// What the user calls it — "Power bill", "Presents".
  name String

  /// Negative for money out, positive for money in — **the same convention as
  /// `Transaction.amount`**, so the breakdown builder branches on the sign exactly
  /// as the historic one does. The editor's expense/income toggle writes the sign;
  /// nobody types a minus.
  amount Decimal @db.Decimal(19, 4)

  /// The currency the figure was entered in, stamped from the workspace's display
  /// currency when the item is created. Stored rather than assumed because the
  /// display currency is derived from whichever accounts are busiest, so it can
  /// change under a budget typed months earlier and silently reinterpret every
  /// amount. Converted at read like everything else.
  currency String

  /// The high-level bucket, and the only one of the three that is required: a
  /// budgeted amount belonging to no group could not appear in the breakdown at
  /// all. `Restrict`, because the group catalog is shared and a refresh must not
  /// be able to orphan a workspace's plan.
  categoryGroupId String
  categoryGroup   CategoryGroup @relation(fields: [categoryGroupId], references: [id], onDelete: Restrict)

  /// Optional extra granularity: the NZFCC subcategory, and the merchant. Both
  /// `SetNull` — losing the narrowing must not delete the budgeted money, which
  /// still belongs to its group.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  /// `once | day | week | month | quarter | year`.
  ///
  /// The recurring values are the metrics' periods minus `taxyear`, so a budget
  /// speaks the same vocabulary the breakdown buckets in. Two deliberate
  /// absences: **fortnight is not a frequency** — it is `week` with `interval: 2`,
  /// which the editor offers as a preset — and **`once` is not a period**, it is
  /// the single-occurrence case event budgets are made of, which is why this is
  /// its own list rather than `Period`.
  frequency String
  /// How many `frequency` steps between occurrences. 1 for monthly, 2 for
  /// fortnightly. Ignored for `once`.
  interval  Int    @default(1)

  /// One real occurrence, from which the rest are derived: its NZ day-of-month,
  /// weekday and month *are* the anchor within the period.
  ///
  /// A single column rather than separate day/weekday/month fields, which can hold
  /// combinations that mean nothing (`anchorDay: 31` on a weekly item) and would
  /// still be needed alongside a date — with `interval > 1` a weekday alone does
  /// not say *which* fortnight is the on one. For `once`, the date it happens.
  anchorDate DateTime @db.Timestamptz(3)

  /// Whether the seeder wrote this row and nobody has agreed to it since. Cleared
  /// on the first user edit, and on a row written through the chat, where the
  /// figure was talked over before it was stored. So "re-infer from history"
  /// refreshes the rows still resting on a guess and leaves the rest alone.
  inferred Boolean @default(false)

  /// How the figure was arrived at: `ai` (a model read the history and named it)
  /// or `computed` (the deterministic pattern detector, used when no model is
  /// reachable or a window's inference failed). Null for a hand-typed row.
  ///
  /// Provenance for the UI's badge, never a control: it says where a figure came
  /// from, not what may be done to it, which is `inferred`'s business. The two are
  /// independent — a chat-written row is `ai` and `inferred: false`, a model
  /// having proposed it *and* the household agreed to it. Editing the amount by
  /// hand clears this.
  inferredSource String?

  /// The one-line rationale from whatever arrived at the figure — the LLM's
  /// ("recurring larger transactions several times a year"), the detector's ("12
  /// payments over 24 months"), or what was settled on in the chat. Shown in a
  /// popover on the provenance badge, so a figure nobody typed can be questioned.
  /// Null for a hand-typed row.
  basis String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([workspaceId])
  @@index([budgetId])
  @@index([categoryGroupId])
  @@index([categoryId])
  @@index([merchantId])
}

/// Point-in-time balance, appended on each sync so the dashboard can chart net
/// worth over time. Akahu only ever exposes the *current* balance, so this
/// history exists only because we record it.
model BalanceSnapshot {
  id Int @id @default(autoincrement())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  currency  String?
  current   Decimal  @db.Decimal(19, 4)
  available Decimal? @db.Decimal(19, 4)
  limit     Decimal? @db.Decimal(19, 4)

  capturedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([accountId, capturedAt])
  @@index([accountId, capturedAt])
}

/// Incremental transaction sync progress, one row per bank link. A high-water
/// mark is a property of the link it was read through — two links refresh at
/// different times and reach back to different dates — so the link id *is* the
/// primary key.
model SyncState {
  bankLinkId String   @id
  bankLink   BankLink @relation(fields: [bankLinkId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// High-water mark: the `date` of the newest transaction stored. The next sync
  /// starts slightly before it, to catch late-settling rows.
  lastTransactionDate DateTime? @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@index([workspaceId])
}

/// Audit log of ingest runs, so a silently failing cron is visible.
model SyncRun {
  id Int @id @default(autoincrement())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Which link this run was for. `SetNull` on delete, so disconnecting a bank
  /// leaves its audit trail behind rather than erasing the record that the syncs
  /// happened.
  bankLinkId String?
  bankLink   BankLink? @relation(fields: [bankLinkId], references: [id], onDelete: SetNull)

  /// Enqueue time for a `queued` run; the worker overwrites it with the real
  /// start when it claims the job, so `finishedAt - startedAt` is execution time
  /// rather than time spent waiting in the queue.
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  /// queued | running | success | failed. Every enqueuer — the web app and the
  /// cron script alike — writes `queued` and nothing more: the app role holds the
  /// INSERT but no catalog DML, and never calls Akahu itself. The sync worker
  /// claims the row (queued → running) and finalises it. A transient failure goes
  /// back to `queued`, so the terminal states are not terminal-once.
  status     String    @default("running")

  /// Whether this run re-fetches the whole history window or syncs incrementally
  /// from the high-water mark. Persisted because the worker runs the job later,
  /// in another process, and must reproduce the mode the button chose.
  full Boolean @default(false)

  /// An explicit lookback window in days, or null for the pipeline's own default.
  /// Persisted for the same reason as `full`: the enqueuer and the process that
  /// runs the job are not the same one, so an argument that isn't stored is
  /// silently dropped.
  days Int?

  /// How many times the worker has claimed this run (queued → running). A run
  /// that keeps failing counts up to `WORKER_MAX_ATTEMPTS` and is then failed for
  /// good; below the cap it re-queues with backoff instead. Also how the
  /// stale-claim reaper decides whether a run abandoned by a dead worker is worth
  /// retrying.
  attempts Int @default(0)

  /// Earliest time a `queued` row may be claimed, or null for "now". Set into the
  /// future when the worker re-queues a failed run, spacing retries out
  /// exponentially; the claim query skips rows whose backoff has not elapsed.
  /// Irrelevant once a row is `running` or terminal.
  nextAttemptAt DateTime? @db.Timestamptz(3)

  accountsSynced     Int @default(0)
  transactionsSynced Int @default(0)

  error String?

  @@index([workspaceId, startedAt])
  @@index([startedAt])
}

/// A GoRules JDM decision graph, executed by the Zen engine to automate
/// transaction enrichment. One document is `active` per workspace; that is the
/// graph the sync and the manual "apply rules" backfill evaluate every
/// transaction against. The graph is stored as JSON text rather than `jsonb`
/// because the app never queries into it: it is loaded whole, parsed and handed
/// to the engine, and `jsonb` would reorder keys for no gain.
model RuleDocument {
  id Int @id @default(autoincrement())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name String
  /// Stable URL-safe identifier, unique *within a workspace*. An identity key
  /// rather than a route segment, the UI editing a single active document in
  /// place. Instance-wide uniqueness would make one workspace's first rule
  /// document collide with another's.
  slug String

  /// The JDM decision graph, serialised with `JSON.stringify` and parsed back
  /// into `{ nodes, edges }` before evaluation.
  content String

  /// Exactly one document should be active *per workspace*: the rules runner
  /// picks that one, and activating a document deactivates the others in the same
  /// workspace.
  active Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, slug])
  @@index([workspaceId, active])
  @@index([active])
}

/// One execution of the rules engine — a per-sync pass or a manual "apply now"
/// backfill. Recorded only when it actually changed something (or errored), so
/// the log reads as what the rules did rather than a heartbeat of every no-op
/// sync. Mirrors `SyncRun`.
model RuleRun {
  /// A cuid: this one appears in a URL, so a counter would hand every visitor a
  /// running total of the instance's rule activity.
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  /// What triggered the run: `sync` (during ingest) | `manual` (Apply now).
  trigger    String
  /// queued | running | success | failed. A `manual` run is enqueued the same way
  /// a sync is — the web app writes a `queued` row and the worker claims it
  /// (queued → running) and finalises it — so the whole-history backfill never
  /// runs in the request. A `sync`-triggered run is created terminal by the
  /// ingest itself.
  status     String    @default("success")

  /// Tallies for the whole run, mirroring the in-memory summary.
  evaluated       Int @default(0)
  categorised     Int @default(0)
  merchantsSet    Int @default(0)
  transfersLinked Int @default(0)
  errors          Int @default(0)

  /// Retry bookkeeping for the queued (`manual`) path, identical to `SyncRun`:
  /// `attempts` counts claims and caps retries, `nextAttemptAt` gates a re-queued
  /// row until its backoff elapses. Both irrelevant to a `sync`-triggered run,
  /// which is never queued.
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @db.Timestamptz(3)

  error String?

  changes FieldChange[]

  @@index([workspaceId, startedAt])
  @@index([startedAt])
}

/// A queued budget inference: read the history and build (or refresh) a budget,
/// off the request.
///
/// Inference talks to a local LLM, which can take a minute or more over several
/// windows — far too long to hold a page render or a form POST open for. So the
/// web app writes a `queued` row and returns straight away; the worker claims it,
/// runs the inference and creates or refreshes the budget. The same queue
/// machinery the sync and rules passes use: atomic claim, retry with backoff,
/// stale-claim reaping.
model BudgetInferenceRun {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The budget this run builds or refreshes: set upfront for a re-infer, null
  /// while a create run is in flight and filled in on success, so it always
  /// points at the budget to show once the run has succeeded. `SetNull`, so
  /// deleting the budget leaves the record of the run behind.
  budgetId String?
  budget   Budget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  /// Who asked for this run, or null for one with no person behind it. Here for
  /// one reason: the run logs itself into a `ChatThread`, a thread is private to
  /// its author, and the only honest owner for that log is whoever pressed the
  /// button. Nothing about *running* the inference uses it. `SetNull`: deleting a
  /// person must not delete the record that the run happened.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// The conversation this run logged itself into, set by the worker as soon as it
  /// opens one. Null until then, and forever for a run nobody owns. `SetNull`, so
  /// deleting a log that has been read leaves the run behind.
  threadId String?
  thread   ChatThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  /// queued | running | success | failed. Same lifecycle as `SyncRun.status`: the
  /// web app writes `queued`, the worker claims it (queued → running) and
  /// finalises it, and a transient failure re-queues with backoff.
  status String @default("queued")

  /// Enqueue time for a queued row, overwritten with the real start when the
  /// worker claims it, so `finishedAt - startedAt` is execution time.
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)

  /// Claim count and retry backoff, exactly as `SyncRun`. The reaper and the
  /// retry-or-fail decision read both.
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @db.Timestamptz(3)

  error String?

  /// When somebody watching the run's log asked it to stop reading and build the
  /// budget from what it had.
  ///
  /// The run happens in the worker, in another process, so there is no signal to
  /// send it and no registry to find it in the way the interactive chat's stop
  /// reaches a turn. This column is the channel: the loop reads it between rounds
  /// and stops there, so stopping takes effect after the step in flight rather
  /// than during it — the honest bound on anything crossing a process boundary
  /// through a database.
  ///
  /// A timestamp rather than a flag, so the log can say when it was asked and a
  /// request arriving after the run ended is still a fact about the row.
  stopRequestedAt DateTime? @db.Timestamptz(3)

  @@index([workspaceId, startedAt])
  @@index([startedAt])
  @@index([budgetId])
  @@index([threadId])
  @@index([userId])
}

/// Mail composed and waiting to be delivered.
///
/// The app writes a row here and stops — INSERT is the only statement the app
/// role holds on this table — and the sync worker sends it. The same split the
/// Akahu tokens have: an SMTP credential that can send mail as this domain has no
/// business in the internet-facing process.
///
/// The app is revoked SELECT rather than merely never reading, because the
/// *contents* matter as much as the credential. A queued invite or reset message
/// carries a working bearer link, so a queue the web role could read would hand a
/// compromise of it every unredeemed one at once — including for workspaces the
/// attacker is not a member of, which is more than that role can reach any other
/// way.
///
/// No `workspaceId`, deliberately. A password reset belongs to a person rather
/// than a workspace, the worker drains this globally, and a row here is never
/// tenant data: it holds an address, a subject, a link and prose, and by standing
/// rule never an amount or a transaction.
model EmailOutbox {
  id String @id @default(cuid())

  /// Recipient and message. `text` is not a courtesy: a message with no plaintext
  /// part scores as spam with most filters, which for an invite presents as
  /// exactly the silent non-delivery this queue exists to surface.
  to      String
  subject String
  text    String
  html    String?

  /// `invite` | `reset`. For reading the queue and the logs; nothing branches on
  /// it, and it is not the body's source of truth — the body is composed once, at
  /// enqueue, so what was queued is what is sent.
  kind String

  /// The run-queue protocol, identical to the sync and rules queues: `queued` |
  /// `running` | `success` | `failed`, with `attempts` capping retries and
  /// `nextAttemptAt` gating a re-queued row until its backoff elapses. A relay
  /// that is down therefore backs off and eventually gives up rather than
  /// spinning, and a worker that dies holding a row is reaped by the same pass.
  status        String    @default("queued")
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @db.Timestamptz(3)

  /// Enqueue time until the worker claims the row and resets it, which is also
  /// the reaper's lease anchor — the same arrangement as `SyncRun`.
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  error      String?

  @@index([status, nextAttemptAt])
  @@index([startedAt])
}

/// An append-only log of every change to an attributable enrichment field.
///
/// One row per field per change, written by all three writers — the Akahu sync,
/// the rules engine, and a person using the app — so "who set this category, and
/// what was it before?" is answered by history rather than by the current value.
/// `Transaction.categorySource`/`merchantSource` still say who *owns* a field
/// now; this says how it got that way. A table and not an `updatedByUserId`
/// column, which would hold only the most recent writer and cost a column per
/// attributable field.
///
/// Changes only, never genesis: a transaction arriving from Akahu already
/// categorised writes nothing here, because `syncedAt` plus a `source` of `akahu`
/// on the row itself already say that. The first logged change carries the
/// original value in `fromLabel`, so the origin survives anyway.
model FieldChange {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// A plain column, not a relation, deliberately: an append-only log must not be
  /// quietly rewritten by a cascade, and readers join the current transaction rows
  /// back in for display while tolerating a since-deleted one.
  transactionId String

  /// Which field changed: `category` | `merchant` | `transfer` | `label` (only a
  /// tag a rule was configured to apply).
  field String

  /// What made the change: `akahu` (the sync) | `user` (a person) | `rule` (the
  /// rules engine). The same vocabulary as `Transaction.categorySource`, and the
  /// same precedence: user beats rule beats akahu.
  source String

  /// The person who made it, when `source` is `user`. Null for `akahu` and `rule`
  /// changes, which have no person behind them — a *manually* triggered rule run
  /// records who asked for it on `RuleRun`, not here, because the person chose to
  /// run the rules rather than to make this particular edit. Also null on rows
  /// written before this instance knew who anyone was.
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// The run that made it, when `source` is `rule`, and what the run report reads.
  ruleRunId String?
  ruleRun   RuleRun? @relation(fields: [ruleRunId], references: [id], onDelete: Cascade)

  /// The value before and after. Ids for joining back, labels stored alongside so
  /// a reader needs no join for the values themselves — and so the history still
  /// reads correctly after a category is renamed or a merchant deleted, which is
  /// the point of a log. `transfer` carries the other leg and no id pair, a group
  /// not being a value.
  fromId    String?
  fromLabel String?
  toId      String?
  toLabel   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// The history panel's query: one transaction's changes, newest first, within
  /// the workspace the scoped client already filters on.
  @@index([workspaceId, transactionId, createdAt])
  @@index([ruleRunId])
  @@index([transactionId])
}

// ---------------------------------------------------------------------------
// Chat
//
// A conversation with the local model, persisted as rows and readable in the app
// rather than as a transcript file on the server nobody looks at. That includes
// the headless budget inference, which logs its whole run into a thread of its
// own (`unattended` below) owned by whoever asked for it.
// ---------------------------------------------------------------------------

/// One conversation.
///
/// **Private to its author**, the one place in this app where membership of a
/// workspace is not enough to read something. Every other tenant table is
/// household data — transactions, budgets, rules — where the scoped client plus
/// RLS is the whole access story. A chat is one person thinking out loud, and the
/// other member of a household did not ask to read it.
///
/// RLS only knows `app.workspace_id`, so the database can keep another *workspace*
/// out but not another *member*. The `userId` filter that does is application
/// code, kept in one place so it cannot be forgotten at a call site.
model ChatThread {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Who it belongs to. Required, unlike `FieldChange.userId`: a thread with no
  /// owner would be one nobody may read.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Taken from the opening message and editable after. Not model-written: that
  /// would be another round trip before the first reply appears.
  title String

  /// Written by a background run rather than by a person talking: the log of one
  /// unattended budget inference.
  ///
  /// A log is a conversation to *read*, not one to take a turn in, and this column
  /// is what says so: the thread page renders it read-only and the turn route
  /// refuses a turn on it. Two things make that necessary. While the run lasts
  /// another process is still writing, so a turn would be two writers on one
  /// thread; and it was held with tools that exist only in that run
  /// (`propose_items`, `finish`).
  ///
  /// Not permanent: a finished log can be taken over, which clears this and makes
  /// the thread an ordinary conversation (see `continuedAt`).
  unattended Boolean @default(false)

  /// When a person took over a finished run's log and carried on in it.
  ///
  /// Taking over clears `unattended`, which is what puts a composer on the page
  /// and lets the turn route claim the thread; this remembers that everything
  /// above the takeover was written by a worker rather than said by anyone. Two
  /// things read it: the page, to mark the boundary, and the turn, which tells the
  /// model what it is picking up — the run's tools are gone and the budget it was
  /// building has already been saved.
  ///
  /// Continued in place rather than copied: a run's transcript is megabytes of
  /// served transactions, and the boundary being visible is what keeps the record
  /// honest without duplicating a household's history.
  continuedAt DateTime? @db.Timestamptz(3)

  /// Set when a turn starts, cleared when it settles. Not the authority on what is
  /// running — the in-process run registry is — but what a freshly rendered page
  /// has to go on, and what says a turn was interrupted by the process dying
  /// rather than by finishing.
  runningSince DateTime? @db.Timestamptz(3)

  /// Which model answers here; null means whatever `LLM_MODEL` currently is.
  /// Stored per thread rather than per workspace because the choice is about the
  /// conversation — a quick one wants a small model, and switching mid-thread is
  /// legitimate when the small one gets stuck.
  model String?

  /// The conversation so far, in prose, standing in for the messages up to
  /// `summarizedThroughSeq`. Null until someone compacts.
  ///
  /// The second half of the same argument as `ChatMessage.elided`: what the model
  /// is shown and what the person can read are different things. The messages are
  /// never deleted — scroll back and they are all there — but the model is handed
  /// the summary and then everything since, which is what lets a conversation
  /// outlive the context window it started in.
  summary String?

  /// The last message the summary accounts for; everything after it is still sent
  /// verbatim. Stored beside the summary rather than derived, since recomputing it
  /// from the summary's age would be a guess.
  summarizedThroughSeq Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  messages ChatMessage[]
  /// The runs that logged themselves here. At most one in practice — a retry opens
  /// a fresh thread rather than appending to the failed attempt's log — but a list,
  /// the foreign key being on the run.
  inferenceRuns BudgetInferenceRun[]

  /// The thread list: one person's threads, most recently used first.
  @@index([workspaceId, userId, updatedAt])
}

/// One message in a thread, stored in the shape the API speaks.
///
/// `role`, `content`, `toolCalls` and `toolCallId` are the OpenAI chat message
/// fields, kept verbatim rather than normalised into something of our own:
/// rehydrating a thread to continue it is then a `map` rather than a
/// reconstruction, with no second representation to drift out of step with what
/// was actually said.
model ChatMessage {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// Position in the conversation, from 0. Ordering by `createdAt` would be a coin
  /// toss between an assistant message and the tool results it triggered, which
  /// arrive in the same millisecond — and the API rejects a tool result that does
  /// not follow its call.
  seq Int

  /// system | user | assistant | tool
  role String

  /// Null on an assistant turn that only called tools and said nothing.
  content String?

  /// The assistant's `tool_calls`, verbatim.
  toolCalls Json?

  /// On a tool result: which call it answers, and which tool ran. The name is
  /// redundant against the call, but saves the UI a lookup to decide how to render
  /// a result and survives if the calling message is ever pruned.
  toolCallId String?
  toolName   String?

  /// Whether this message's content is dropped when rebuilding the model's view
  /// of the thread. A served page of transactions has done its job once it has
  /// been reasoned over, and carrying thousands of rows forward is what runs a
  /// small local model out of context. The row keeps its full content regardless:
  /// the elision is for the model, not for the person, who can still scroll back
  /// and see what it read.
  elided Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([threadId, seq])
  @@index([workspaceId, threadId, seq])
}
