// Personal finance dashboard, backed by Postgres.
// Data is ingested from the Akahu API by `pnpm db:sync` (scripts/ingest.ts).
//
// Akahu ids are used as primary keys so that re-running a sync is idempotent.
//
// Money is `Decimal @db.Decimal(19, 4)`, never `Float`: sums have to be exact.
// Prisma hands these back as decimal.js objects, so the read layer converts them
// to numbers at the query boundary — see lib/server/queries. Rates are not money
// and stay `Float` (see `FxRate.rate`).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
//
// The tenant is a `Workspace`. Financial data hangs off a workspace, never off a
// user: a solo user is a workspace with one member and a shared one is a
// workspace with two, so the query layer can't tell the difference and doesn't
// need to. See docs/multi-user.md.
//
// These tables are empty until phase 3 brings auth — except `Workspace` and
// `BankLink`, which are populated with one bootstrap row each so the existing
// single-user data has an owner.
// ---------------------------------------------------------------------------

/// A tenant: the thing financial data belongs to, and the unit of sharing.
model Workspace {
  id   String @id @default(cuid())
  name String
  /// URL-safe identity, unique across the instance. Phase 3 routes on it
  /// (`app/w/[workspace]/`), which is also what keeps any future cache key
  /// workspace-specific for free.
  slug String @unique

  /// Better Auth's organization plugin declares both, and its endpoints write
  /// them. Neither is rendered anywhere yet; they are the library's columns, not
  /// a feature this app has decided to have.
  logo     String?
  metadata String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members   Membership[]
  invites   Invite[]
  bankLinks BankLink[]

  // Every tenant-owned table, related rather than left as a loose column, so
  // that deleting a workspace cascades to its financial data in one statement.
  // That is not tidiness: Akahu's accreditation (and the Privacy Act) require
  // deletion on request to be real, so "delete a workspace" must never become a
  // soft delete of the rows that matter.
  accounts            Account[]
  transactions        Transaction[]
  pendingTransactions PendingTransaction[]
  balanceSnapshots    BalanceSnapshot[]
  transferGroups      TransferGroup[]
  conflicts           TransactionConflict[]
  merchants           Merchant[]
  ruleDocuments       RuleDocument[]
  ruleRuns            RuleRun[]
  fieldChanges        FieldChange[]
  syncStates          SyncState[]
  syncRuns            SyncRun[]
}

/// A person. Deliberately minimal, and matches the core fields Better Auth
/// expects so phase 3 adopts this table rather than renaming it: Better Auth
/// owns authentication (credentials, sessions, MFA); this app only ever needs
/// the identity a `Membership` points at.
///
/// Phase 3 took that bet up: Better Auth's schema mapped onto this table with no
/// rename and no migration of the columns already here.
model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  /// Whether TOTP is enrolled. Whether it is *required* is `REQUIRE_MFA`, not a
  /// column — see docs/multi-user.md. Nullable because Better Auth's twoFactor
  /// plugin declares it so.
  twoFactorEnabled Boolean? @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sessions       Session[]
  authAccounts   AuthAccount[]
  twoFactors     TwoFactor[]
  memberships    Membership[]
  invitesSent    Invite[]      @relation("InviteInvitedBy")
  bankLinksAdded BankLink[]
  // Deliberately `onDelete: SetNull` on the other side, unlike everything else
  // hanging off a workspace: deleting a person must not delete the record that
  // the edit happened, only the claim about who made it.
  fieldChanges   FieldChange[]
}

// ---------------------------------------------------------------------------
// Authentication
//
// Better Auth's tables, under this schema's names. Nothing in the app reads them
// directly: they are the library's, reached through `lib/server/auth`, and the
// mapping that points it at them lives there too.
//
// Their shape is not ours to design — it is generated by `@better-auth/cli
// generate`, and this section is that output reconciled with the conventions
// here (`Timestamptz(3)`, no `@@map`). If a Better Auth upgrade wants a column,
// re-run the CLI and diff rather than guessing.
// ---------------------------------------------------------------------------

/// A logged-in session. Better Auth owns the token and the expiry; per-request
/// membership re-validation (see `lib/server/auth/session.ts`) is what makes a
/// revoked membership take effect on the next request rather than at expiry.
model Session {
  id        String   @id @default(cuid())
  /// The session cookie's value. Unique: it is looked up on every request.
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)

  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The organization plugin's "active organization", mapped to our vocabulary.
  /// Nothing reads it: this app routes the workspace in the URL
  /// (`app/w/[workspace]/`) and re-checks membership per request, so a session
  /// carrying a workspace id would be a second, staler answer to a question the
  /// path already asks. Present because the plugin's endpoints write it.
  activeWorkspaceId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// A credential, or a linked identity at an OAuth provider.
///
/// Better Auth calls this `account`. This schema's `Account` is a *bank*
/// account and was here first, so the model is renamed and the mapping in
/// `lib/server/auth` (`account: { modelName: "authAccount" }`) points the
/// library at it. The clash is the only one in the whole adoption.
///
/// `password` holds a hash, never a password — Better Auth owns the hashing.
model AuthAccount {
  id String @id @default(cuid())

  /// The id at the provider; for credentials, the user's own id.
  accountId  String
  /// `credential` for email+password, else the OAuth provider's name.
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// Short-lived tokens Better Auth issues for email verification and password
/// reset. Rows are transient; nothing here refers to them.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

/// A user's TOTP enrolment: the shared secret and their backup codes.
///
/// This is the highest-value row in the auth tables — the secret is a second
/// factor at rest — and it is why T23's "encrypt the backups" is not optional
/// once real users exist.
model TwoFactor {
  id String @id @default(cuid())

  secret      String
  backupCodes String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Set false while enrolment is mid-flight, true once a code has been proven.
  verified Boolean? @default(true)

  /// Better Auth's own lockout on repeated failed challenges — the T1
  /// (credential stuffing) answer for the second factor.
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
}

/// A user's place in a workspace, and what they may do there. Many-to-many from
/// day one: a user can belong to and create several workspaces. Any future limit
/// on that is a check inside `createWorkspace`/`acceptInvite` — the only two
/// places a membership is born — not a schema reshape.
///
/// Better Auth's organization plugin calls this `member` and owns its writes;
/// `membershipLimit` in its accept path is the seam those future limits plug
/// into, exactly where the plan said they would go.
model Membership {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// owner | editor | viewer. A plain string, matching this schema's no-enums
  /// style, and enforced at the write boundary (`requireRole`), never only in
  /// the UI. Adding a role later is a new string plus its place in the
  /// ordering, not a migration.
  role String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// One membership per user per workspace; the role is a field, not a second row.
  @@unique([workspaceId, userId])
  @@index([userId])
}

/// A pending invitation to join a workspace. Redeeming one is the other entry
/// point (with `createWorkspace`) for a new membership.
///
/// ## Why there is no `token` column
///
/// Phase 2 modelled this with a `token @unique` — a bearer secret in the invite
/// link. Better Auth's organization plugin, which now owns this table, does not
/// work that way, and its way is better. The link carries the invite's *id*, and
/// `acceptInvitation` requires a session, then refuses unless
/// `invitation.email` equals the logged-in user's email, the row is still
/// `pending`, and `expiresAt` is in the future — flipping the status with a
/// compare-and-set so redemption is atomically single-use.
///
/// So the id is not the capability; being logged in as the invited person is.
/// That satisfies the standing rule that ids are identifiers and not
/// capabilities (threat-model.md), and it is a stronger answer to T12 than a
/// secret in a column: a forwarded link is useless to whoever receives it.
model Invite {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Who it was addressed to, and the role they get on acceptance. Acceptance
  /// checks this against the session's email, so it is a control, not a label.
  email String
  role  String

  /// The invitee's name, if the owner typed one when sending the invite. Purely
  /// a convenience: it pre-fills the signup form so the person doesn't have to
  /// state a name the owner already knew. Nullable and never a control — the
  /// invitee can change it, and Better Auth's `createInvitation` doesn't set it
  /// (the `invite` action writes it in a second step), so an invite made any
  /// other way simply has none.
  name String?

  /// pending | accepted | rejected | canceled. Better Auth transitions it from
  /// `pending` exactly once, which is what makes an invite single-use.
  status String @default("pending")

  invitedByUserId String?
  invitedBy       User?   @relation("InviteInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([workspaceId])
  @@index([email])
}

/// A workspace's connection to Akahu — the thing accounts are ingested through,
/// and the unit a user revokes.
///
/// v1 holds exactly one bootstrap row per instance, carrying no credentials: the
/// tokens stay in env (`AKAHU_APP_ID_TOKEN`/`AKAHU_USER_ACCESS_TOKEN`) and are
/// resolved by link. Phase 7's per-user OAuth adds encrypted token columns here
/// and nothing else moves — that's the point of introducing the model now.
///
/// `status`/`revokedAt` are also what Akahu's accreditation requires an app to
/// expose to consumers (see docs/multi-user.md), so they are modelled from the
/// start rather than retrofitted.
model BankLink {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// What the user calls this connection.
  name String

  /// ACTIVE | INACTIVE (Akahu stopped refreshing it) | REVOKED (access withdrawn,
  /// here or at Akahu). Ingest only runs for ACTIVE links.
  status String @default("ACTIVE")

  /// Set when access ends, whichever side ended it. Kept distinct from deletion:
  /// a revoked link stops syncing but its already-ingested history remains until
  /// the workspace is deleted.
  revokedAt DateTime? @db.Timestamptz(3)

  /// Who connected it. Null for the bootstrap link, which predates users.
  connectedByUserId String?
  connectedBy       User?   @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  accounts   Account[]
  syncState  SyncState?
  syncRuns   SyncRun[]

  @@index([workspaceId, status])
}

/// A connected financial account, mirrored from Akahu's `/accounts`.
model Account {
  /// Akahu account id, e.g. `acc_...`
  id               String  @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The Akahu connection this account was ingested through, and the thing a
  /// user revokes to disconnect it. Restrict, not Cascade: unlinking a bank must
  /// be a deliberate decision about the history, not a silent shredding of it.
  bankLinkId String
  bankLink   BankLink @relation(fields: [bankLinkId], references: [id], onDelete: Restrict)

  name             String
  /// ACTIVE | INACTIVE
  status           String
  /// CHECKING | SAVINGS | CREDITCARD | LOAN | KIWISAVER | ...
  type             String
  formattedAccount String?

  /// The institution the account is held at.
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  /// Account holder name as exposed by the provider, when available.
  holder String?

  /// What this account can do, according to Akahu: TRANSACTIONS, PAYMENT_TO, PAYMENT_FROM.
  hasTransactions Boolean @default(false)
  canReceivePayments Boolean @default(false)
  canInitiatePayments Boolean @default(false)

  /// Latest balance, flattened from `balance`. Absent for some account types.
  currency         String?
  balanceCurrent   Decimal? @db.Decimal(19, 4)
  balanceAvailable Decimal? @db.Decimal(19, 4)
  balanceLimit     Decimal? @db.Decimal(19, 4)
  overdrawn        Boolean?

  /// When Akahu last refreshed each part of the account data.
  refreshedBalance     DateTime? @db.Timestamptz(3)
  refreshedMeta        DateTime? @db.Timestamptz(3)
  refreshedTransactions DateTime? @db.Timestamptz(3)
  refreshedParty       DateTime? @db.Timestamptz(3)

  /// When Akahu last refreshed the account, distinct from when we last synced it.
  refreshedAt DateTime? @db.Timestamptz(3)
  syncedAt    DateTime  @updatedAt @db.Timestamptz(3)

  transactions Transaction[]
  pending      PendingTransaction[]
  balances     BalanceSnapshot[]

  @@index([status])
  @@index([connectionId])
}

/// A financial institution connected through Akahu. For personal apps this is
/// built from the `connection` object embedded in each account; for full apps
/// it can be enriched from `/connections`.
model Connection {
  /// Akahu connection id, e.g. `conn_...`
  id   String @id
  name String
  /// URL of the institution's logo.
  logo String?
  /// classic | official
  connectionType String

  accounts     Account[]
  transactions Transaction[]
  pending      PendingTransaction[]

  syncedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([connectionType])
}

/// A settled transaction, mirrored from Akahu's `/transactions`.
/// Enriched fields (merchant, category, meta) are only present on enriched
/// transactions, so they are all nullable.
model Transaction {
  /// Akahu transaction id, e.g. `trans_...`
  id        String  @id

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  date         DateTime @db.Timestamptz(3)
  description  String
  /// Negative for money out, positive for money in.
  amount       Decimal @db.Decimal(19, 4)
  /// Account balance after this transaction, when the institution reports it.
  balance      Decimal? @db.Decimal(19, 4)
  /// DEBIT | CREDIT | TRANSFER | EFTPOS | FEE | ...
  type         String
  hash         String?

  merchantId    String?
  merchant      Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// The `personal_finance` spending group this row sits under, as a real group id
  /// (NZFCC `group_...`, or an invented `group_custom_...` income group). Kept as a
  /// plain FK column — not derived through the category relation — because an
  /// uncategorised inflow still carries an income group with no category, and
  /// because metrics `groupBy` it (Prisma can't group across a relation). The
  /// group *name* lives only on `CategoryGroup`; read it through `categoryGroup.name`.
  categoryGroupId String?
  categoryGroup   CategoryGroup? @relation(fields: [categoryGroupId], references: [id], onDelete: SetNull)

  /// Who owns the enrichment, per editable field: `akahu` (mirrored, and the
  /// sync may overwrite it) or `user` (hand-set, and the sync must not clobber
  /// it — it records a TransactionConflict instead when Akahu later disagrees).
  categorySource String @default("akahu")
  merchantSource String @default("akahu")

  particulars  String?
  code         String?
  reference    String?
  otherAccount String?
  cardSuffix   String?

  /// Foreign currency conversion details, when the transaction was made in
  /// another currency. The rate is a ratio, not money — it stays `Float`.
  conversionAmount Decimal? @db.Decimal(19, 4)
  conversionCurrency String?
  conversionRate Float?

  /// URL of a merchant logo image for this transaction, when Akahu provides one.
  logo String?

  /// The transfer this row is one leg of, once it's been grouped with the other
  /// side(s) of an internal transfer. A group holds two *or more* legs, so it
  /// spans not just a simple out/in pair but a multi-currency conversion and a
  /// separate fee row too. Any "is this a transfer" filter is a plain
  /// `transferGroupId: null` test on either leg. Kept a plain column (not a Prisma
  /// relation) to match the denormalised style here; group members are resolved by
  /// querying this column. Always user-made: Akahu tags a row's `type` as TRANSFER
  /// but never says which rows belong together.
  transferGroupId String?
  transferGroup   TransferGroup? @relation(fields: [transferGroupId], references: [id], onDelete: SetNull)

  /// Timestamps as reported by Akahu, not by us.
  createdAt DateTime? @db.Timestamptz(3)
  updatedAt DateTime? @db.Timestamptz(3)
  syncedAt  DateTime  @default(now()) @db.Timestamptz(3)

  // A transaction's nature is derived, not stored: money in (`amount > 0`) is
  // income; money out (`amount < 0`) is spending, categorised when Akahu supplied
  // a `categoryGroup` and uncategorised otherwise. No classifier writes here.

  conflicts TransactionConflict[]

  // The prefix of nearly every metrics query, now that they all filter by
  // workspace before they filter by anything else.
  @@index([workspaceId, date])
  @@index([accountId, date])
  @@index([date])
  @@index([categoryGroupId])
  @@index([categoryId])
  @@index([merchantId])
  @@index([transferGroupId])
  @@index([connectionId])
  // Trigram indexes for the free-text search, which runs as ILIKE '%term%' and
  // so can use no btree index. Declared here rather than left as raw SQL in the
  // migration, or `migrate dev` reads them as drift and offers to drop them.
  // Every column the search ORs over is indexed: Postgres only combines OR
  // branches into a BitmapOr when each one has an index.
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transaction_description_trgm_idx")
  @@index([particulars(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transaction_particulars_trgm_idx")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transaction_code_trgm_idx")
  @@index([reference(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transaction_reference_trgm_idx")
  @@index([otherAccount(ops: raw("gin_trgm_ops"))], type: Gin, map: "Transaction_otherAccount_trgm_idx")
}

/// A pending (authorised but not-yet-settled) transaction, mirrored from Akahu's
/// `/transactions/pending`. Unlike `Transaction` these are transient and have no
/// stable id: a pending row vanishes once it settles (reappearing under a real
/// `trans_...` id with no back-reference) or is cancelled. So each sync *replaces*
/// this whole table with Akahu's current pending set rather than upserting by id
/// (see `syncPendingTransactions`). Display-only: deliberately kept out of every
/// balance, spend, runway and rules path — pending money is not settled money.
/// Pending rows are also less enriched than settled ones — Akahu attaches `meta`
/// but no merchant or category — so those columns are absent here.
model PendingTransaction {
  id        Int     @id @default(autoincrement())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  date        DateTime @db.Timestamptz(3)
  description String
  /// Negative for money out, positive for money in.
  amount      Decimal @db.Decimal(19, 4)
  /// DEBIT | CREDIT | TRANSFER | EFTPOS | FEE | ...
  type        String

  /// Akahu's `updated_at`. Pending rows carry no `created_at`.
  akahuUpdatedAt DateTime @db.Timestamptz(3)

  particulars  String?
  code         String?
  reference    String?
  otherAccount String?
  cardSuffix   String?

  conversionAmount   Decimal? @db.Decimal(19, 4)
  conversionCurrency String?
  conversionRate     Float?

  syncedAt DateTime @default(now()) @db.Timestamptz(3)

  // Each sync replaces this table for one workspace (see `syncPendingTransactions`),
  // so the workspace is both the read prefix and the delete predicate.
  @@index([workspaceId, date])
  @@index([accountId, date])
  @@index([date])
}

/// A user-defined grouping of transactions that together make up one internal
/// transfer: the outflow and inflow legs, plus any currency-conversion or fee
/// rows. Its legs are excluded from income/spend/net metrics (see the notes on
/// `Transaction.transferGroupId`). Akahu never links the legs itself, so every
/// group here is hand-made on the transaction page. Deliberately relation-less on
/// the Prisma side: legs point at it by `transferGroupId` and are read back with a
/// plain query, matching the denormalised style of the rest of the schema.
model TransferGroup {
  /// A cuid, not a counter. These ids identify one workspace's transfer; a
  /// sequential one would publish how many transfers exist across every
  /// workspace on the instance, and could be walked. Scoping makes a guessed id
  /// return nothing — this makes there be nothing to guess.
  id        String   @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  transactions Transaction[]

  @@index([workspaceId])
}

/// Historical daily FX reference rates from the ECB, fetched via frankfurter.dev
/// during `db:sync` and cached so cross-currency transfer matching runs offline
/// like every other read here. `rate` is units of `currency` per 1 unit of `base`
/// on `date` (the base is stored as 1); convert A→B with `amount * rateB / rateA`,
/// which is base-agnostic. We quote against NZD (see lib/server/fx.ts) so the
/// common NZD↔X pair is a single lookup. The ECB only publishes on business days,
/// so a weekend/holiday transaction reads the most recent prior date.
model FxRate {
  date     DateTime @db.Timestamptz(3)
  base     String
  currency String
  rate     Float

  @@id([date, base, currency])
  @@index([base, currency, date])
}

/// A divergence between a user-set enrichment field and what a later Akahu sync
/// reported for it. Raised only when a `user`-owned field (see
/// `Transaction.categorySource`/`merchantSource`) receives a *different, non-null*
/// value from Akahu — an inflow Akahu simply leaves uncategorised never conflicts.
/// The user's value is kept; this row is the prompt to reconcile on the tx page.
model TransactionConflict {
  id            Int         @id @default(autoincrement())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  /// Which enrichment field diverged: `category` | `merchant`.
  field String

  /// What owns the value we are keeping: `user` (someone set it by hand) or
  /// `rule` (their rules set it). Both outrank Akahu, so both are defended
  /// against the sync and both can therefore diverge from it — but the reader is
  /// owed the difference, because "you set this" and "your rule set this" call
  /// for different fixes. Every conflict raised before this column existed was
  /// user-held by construction, the sync having protected nothing else, so the
  /// backfill is `user` and is not a guess.
  heldSource String @default("user")

  /// The value being kept (see `heldSource`), for display without a join. Named
  /// `userValue*` from when the user was the only owner the sync deferred to.
  userValueId    String?
  userValueLabel String?
  /// The value Akahu reported on the sync that raised this, for a side-by-side.
  akahuValueId    String?
  akahuValueLabel String?

  /// `open` (awaiting the user) | `dismissed` (user kept theirs; don't re-nag
  /// unless Akahu's value changes again).
  status String @default("open")

  detectedAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  // One live conflict per field per transaction: a new sync updates it in place
  // rather than stacking duplicates.
  @@unique([transactionId, field])
  @@index([status])
}

/// A merchant, mirrored from Akahu's transaction enrichment. One `merchant`
/// object recurs across thousands of transactions, so it is stored once here and
/// referenced by `Transaction.merchantId` rather than copied onto every row.
/// https://developers.akahu.nz/docs/the-transaction-model#merchant
model Merchant {
  /// Akahu merchant id, e.g. `merchant_...`
  id   String @id

  /// The one table that is half catalog, half tenant data.
  ///
  /// `null` = Akahu's global merchant catalog (`merchant_...`), shared by every
  /// workspace. Set = a private merchant a user minted here (`user_...`, see
  /// `createMerchantAndSetForTransaction`) — a name they typed, which is their
  /// data and nobody else's.
  ///
  /// So reads OR the two together and creates always stamp the workspace. This
  /// is the one model where the scoped client cannot simply inject an equality
  /// filter; see `scopedDb`.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name String
  /// The merchant's website, when Akahu resolved one. Previously discarded at
  /// ingest; kept now so no enrichment field is lost.
  website String?
  /// URL of a logo image for this merchant, when Akahu provides one.
  logo String?

  transactions Transaction[]

  // A business can arrive under more than one id (Akahu has two for "Kamo Vets"),
  // so name is not unique — it is indexed for lookup, not constrained.
  @@index([name])
  // The search matches merchant names through a relation filter; same trigram
  // reasoning as `Transaction`.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Merchant_name_trgm_idx")
}

/// A `personal_finance` spending group (or an invented income group), stored once
/// and referenced by both `Category` and `Transaction` rather than having its
/// name copied onto every row. Populated at ingest from the NZFCC mirror and, as a
/// safety net, from each transaction's enrichment (see lib/server/sync.ts) — the
/// same once-and-referenced pattern as `Merchant`.
model CategoryGroup {
  /// Real NZFCC `group_...` id, or an invented `group_custom_...` income group id.
  id   String @id
  name String

  categories   Category[]
  transactions Transaction[]
}

/// The NZFCC category catalog, mirrored from nzfcc.org so an `nzfcc_...` id can
/// be resolved to its name and spending group locally. Refreshed on every
/// `db:sync`, so a category the standard adds appears the next run.
model Category {
  /// NZFCC category id, e.g. `nzfcc_...`
  id        String @id
  name      String
  /// debit (spending) | credit (income)
  direction String

  /// The `personal_finance` group. NZFCC leaves this absent on credit categories,
  /// so the catalog fills those with a custom income group — "Periodic Income" or
  /// "Other Income" (see lib/nzfcc.ts) — to match the group on inflows. The group
  /// name lives on `CategoryGroup`; read it through `group.name`.
  groupId String?
  group   CategoryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  syncedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([groupId])
  // The search matches category names through a relation filter; same trigram
  // reasoning as `Transaction`.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Category_name_trgm_idx")
}

/// Point-in-time balance, appended on each sync so the dashboard can chart
/// net worth over time. Akahu only ever exposes the *current* balance, so this
/// history only exists because we record it.
model BalanceSnapshot {
  id        Int     @id @default(autoincrement())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  currency  String?
  current   Decimal  @db.Decimal(19, 4)
  available Decimal? @db.Decimal(19, 4)
  limit     Decimal? @db.Decimal(19, 4)

  capturedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([accountId, capturedAt])
  @@index([accountId, capturedAt])
}

/// Incremental transaction sync progress, one row per bank link.
///
/// Was a single `"singleton"` row, which was only ever right because there was
/// one connection in the world. A high-water mark is a property of the link it
/// was read through — two links refresh at different times and reach back to
/// different dates — so the link id *is* the primary key.
model SyncState {
  bankLinkId String   @id
  bankLink   BankLink @relation(fields: [bankLinkId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// High-water mark: the `date` of the newest transaction we have stored.
  /// The next sync starts slightly before this to catch late-settling rows.
  lastTransactionDate DateTime? @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@index([workspaceId])
}

/// Audit log of ingest runs, so a silently failing cron is visible.
model SyncRun {
  id         Int       @id @default(autoincrement())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Which link this run was for, so `/sync` and the nav's status widget read
  /// per-workspace history. Nullable, and `SetNull` on delete, so disconnecting
  /// a bank leaves its audit trail behind rather than erasing the record that
  /// the syncs happened.
  bankLinkId String?
  bankLink   BankLink? @relation(fields: [bankLinkId], references: [id], onDelete: SetNull)

  /// When the row was created: for a `queued` run that is when the web app
  /// enqueued it; the worker overwrites it with the real start when it claims the
  /// job, so `finishedAt - startedAt` is execution time, not time spent waiting in
  /// the queue.
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  /// queued | running | success | failed. `queued` is the state the web app
  /// writes (phase 7): it can enqueue a run — a tenant INSERT it already holds —
  /// but no longer runs the ingest itself, so `money_app` needs no catalog DML and
  /// never calls Akahu. The `money_sync` worker claims the row (queued → running)
  /// and finalises it. The cron script still creates its rows as `running`. A run
  /// that fails transiently goes back to `queued` (see `attempts`) rather than
  /// straight to `failed`, so the two are not strictly terminal-once.
  status     String    @default("running")

  /// Whether this run re-fetches the whole history window (`--full`) or syncs
  /// incrementally from the high-water mark. Persisted because the worker runs the
  /// job later, in another process, and must reproduce the mode the button chose.
  full Boolean @default(false)

  /// How many times the worker has claimed this run (queued → running). Bumped on
  /// every claim, so a run that keeps failing counts up until it hits the worker's
  /// `WORKER_MAX_ATTEMPTS` cap and is failed for good. A transient failure below
  /// the cap re-queues the row with backoff (`nextAttemptAt`) instead. Also how the
  /// stale-claim reaper decides whether a run abandoned by a dead worker is worth
  /// retrying or should be failed.
  attempts Int @default(0)

  /// Earliest time a `queued` row may be claimed, or null for "now". The worker
  /// sets this in the future when it re-queues a failed run, spacing retries out
  /// with exponential backoff; the claim query skips rows whose backoff has not
  /// elapsed. Irrelevant once a row is `running`/terminal.
  nextAttemptAt DateTime? @db.Timestamptz(3)

  accountsSynced     Int @default(0)
  transactionsSynced Int @default(0)

  error String?

  @@index([workspaceId, startedAt])
  @@index([startedAt])
}

/// A GoRules JDM decision graph, executed by the Zen engine to automate
/// transaction enrichment (see lib/server/rules.ts). Rules are taught from a
/// transaction ("Create rule from this transaction") and reviewed on `/rules`.
/// One document is `active` at a time; that is the graph the sync and the manual
/// "apply rules" backfill evaluate every transaction against. The graph is stored
/// as its JSON text in `content` — deliberately text rather than Postgres `jsonb`,
/// because the app never queries into the graph: it is loaded whole, parsed, and
/// handed to the engine, and `jsonb` would reorder keys for no gain here.
model RuleDocument {
  id   Int    @id @default(autoincrement())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name String
  /// Stable URL-safe identifier, unique *within a workspace*. The UI now edits a
  /// single active document in place, so this is an identity key rather than a
  /// route segment. Instance-wide uniqueness would have made the second
  /// workspace's first rule document collide with the first workspace's.
  slug String

  /// The JDM decision graph, serialised with `JSON.stringify`. Parsed back into
  /// `{ nodes, edges }` before evaluation.
  content String

  /// Exactly one document should be active *per workspace*. The rules runner
  /// picks the active one; activating a document deactivates the others in the
  /// same workspace (see the rules actions).
  active Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, slug])
  @@index([workspaceId, active])
  @@index([active])
}

/// One execution of the rules engine — a per-sync pass or a manual "apply now"
/// backfill (see lib/server/rules.ts `runRules`). Recorded only when it actually
/// changed something (or errored), so the log reads as "what the rules did" rather
/// than a heartbeat of every no-op sync. Mirrors `SyncRun`.
model RuleRun {
  /// A cuid: this one appears in a URL (`/rules/runs/<id>`), so a counter would
  /// hand every visitor a running total of the instance's rule activity.
  id         String    @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  /// What triggered the run: `sync` (during ingest) | `manual` (Apply now).
  trigger    String
  /// queued | running | success | failed. A `manual` run is now enqueued the same
  /// way a sync is (phase 7): the web app writes a `queued` row — a tenant INSERT
  /// `money_app` holds — and the `money_sync` worker claims it (queued → running)
  /// and finalises it, so the whole-history backfill no longer runs in the request.
  /// A `sync`-triggered run is still created terminal by the ingest itself.
  status     String    @default("success")

  /// Tallies for the whole run, mirroring the in-memory summary.
  evaluated       Int @default(0)
  categorised     Int @default(0)
  merchantsSet    Int @default(0)
  transfersLinked Int @default(0)
  errors          Int @default(0)

  /// Retry bookkeeping for the queued (`manual`) path, identical to SyncRun:
  /// `attempts` counts claims and caps retries; `nextAttemptAt` gates a re-queued
  /// row until its backoff elapses. Both irrelevant to a `sync`-triggered run,
  /// which is never queued.
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @db.Timestamptz(3)

  error String?

  changes FieldChange[]

  @@index([workspaceId, startedAt])
  @@index([startedAt])
}

/// An append-only log of every change to an attributable enrichment field.
///
/// One row per field per change, written by all three writers — the Akahu sync,
/// the rules engine, and a person using the app — so "who set this category, and
/// what was it before?" is answered by history rather than by the current value.
/// `Transaction.categorySource`/`merchantSource` still say who *owns* a field
/// now; this says how it got that way.
///
/// Why a table and not an `updatedByUserId` column: a column holds only the most
/// recent writer and forgets everything before it, and it costs a column per
/// attributable field. This started life as `RuleApplication` — the same shape,
/// for one writer — and generalising it to all three subsumed both. See
/// docs/multi-user.md.
///
/// Changes only, never genesis: a transaction arriving from Akahu already
/// categorised writes nothing here, because `syncedAt` plus a `source` of `akahu`
/// on the row itself already say that. The first logged change carries the
/// original value in `fromLabel`, so the origin survives anyway.
model FieldChange {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// A plain column, not a relation, and deliberately so: an append-only log must
  /// not be quietly rewritten by a cascade, and the rules-run report has always
  /// joined the current transaction rows back in for display while tolerating a
  /// since-deleted one. (Inherited from `RuleApplication`, which did the same.)
  transactionId String

  /// Which field changed: `category` | `merchant` | `transfer`.
  field String

  /// What made the change: `akahu` (the sync) | `user` (a person) | `rule` (the
  /// rules engine). The same vocabulary as `Transaction.categorySource`, and the
  /// same precedence: user beats rule beats akahu.
  source String

  /// The person who made it, when `source` is `user`.
  ///
  /// Null on every row written before phase 3, which is the honest reading rather
  /// than a fudge: this instance did not know who anyone was yet. Also null for
  /// `akahu` and `rule` changes, which have no person behind them — a *manually*
  /// triggered rule run records who asked for it on `RuleRun`, not here, because
  /// the person chose to run the rules, not to make this particular edit.
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// The run that made it, when `source` is `rule`. What `RuleApplication.runId`
  /// was, and what `/rules/runs/<id>` still reads.
  ruleRunId String?
  ruleRun   RuleRun? @relation(fields: [ruleRunId], references: [id], onDelete: Cascade)

  /// The value before and after. Ids for joining back, labels stored alongside so
  /// a reader needs no join for the values themselves — and so the history still
  /// reads correctly after a category is renamed or a merchant deleted, which is
  /// the point of a log. `transfer` carries the other leg: no id pair, since a
  /// group is not a value.
  fromId    String?
  fromLabel String?
  toId      String?
  toLabel   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  /// The transaction history panel's query: one transaction's changes, newest
  /// first, within the workspace the scoped client already filters on.
  @@index([workspaceId, transactionId, createdAt])
  @@index([ruleRunId])
  @@index([transactionId])
}
