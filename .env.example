# Postgres. `pnpm db:up` starts the local one defined in compose.yaml; the
# credentials below match that service and are for local development only.
# A hosted deployment wants a pooled connection string and `sslmode=require`.
DATABASE_URL="postgresql://money:money@127.0.0.1:5432/money?schema=public"

# Akahu credentials — https://my.akahu.nz
# App token identifies this app; the user token grants read access to your
# accounts and transactions.
AKAHU_APP_ID_TOKEN=
AKAHU_USER_ACCESS_TOKEN=
