# Postgres. `pnpm db:up` starts the local one defined in compose.yaml; the
# credentials below match that service and are for local development only.
# A hosted deployment wants a pooled connection string and `sslmode=require`.
DATABASE_URL="postgresql://money:money@127.0.0.1:5432/money?schema=public"

# Auth. The secret signs session tokens: generate one with
# `openssl rand -base64 32`. There is no default and no generated fallback on
# purpose — a per-process secret would log everyone out on every restart, and
# two container replicas would never agree on a session.
#
# Rotating it invalidates every session at once, which is the break-glass move
# if a session is ever believed stolen.
BETTER_AUTH_SECRET=

# The app's own origin. Better Auth otherwise infers it from the incoming
# request, which means a `Host` header decides how same-origin is judged. Set it.
# In a deployment this is the external URL you actually browse to, through
# whatever reverse proxy is in front — not the container's internal address.
BETTER_AUTH_URL="http://localhost:3000"

# Whether TOTP enrolment is mandatory. The capability always ships; this only
# decides whether an unenrolled user is walked through enrolment before reaching
# any data. Off, the household host stays friction-free and anyone who wants a
# second factor can still turn it on. On is the posture Akahu's accreditation
# requires. "true" to enforce; anything else is off.
REQUIRE_MFA=

# Set for a plain-http deployment with no TLS (a trusted LAN). It drops
# `upgrade-insecure-requests` from the CSP in proxy.ts, which would otherwise
# rewrite every subresource to https:// and fail, and suppresses the HSTS header
# next.config.ts otherwise sends in production — which would lock the browser to
# a scheme this origin cannot answer on. "1" or "true"; leave empty for https,
# which is what any deployment reachable off the LAN should be.
INSECURE_HTTP=

# --- Email delivery (all optional) ---
# Invites and password-reset links are copyable links handed over by the person
# who generated them, and stay that way unless SMTP_HOST is set — a self-host may
# have no relay to send through. Set these and the same links are also emailed.
# The copyable link remains on the page either way, so a send that fails is still
# recoverable by hand, which matters because the dangerous failure here is the
# quiet one: an owner clicks Invite, believes it went, and nobody ever receives it.
#
# The web app does not send. It queues a row and the worker delivers it, the same
# split the Akahu tokens have and for the same reason — a credential that can send
# mail as your domain has no business in the internet-facing process. So these are
# read only by the worker, and blanked on the app and cron services in
# compose.prod.yaml and the quadlet files.
#
# Links in those emails are built from BETTER_AUTH_URL above, because a message
# composed on the server has no browser origin to read. That promotes it from "how
# same-origin is judged" to "where a password-reset capability points": set it
# wrong and you mail a working reset link to a host you do not control.
SMTP_HOST=
# 465 for implicit TLS, 587 for STARTTLS. Encryption is derived from the port, so
# there is nothing else to set for either.
SMTP_PORT=465
# Fastmail wants the full address including the domain; other providers differ
# (SES issues a separate username that is not an address at all). This and the
# password are both optional — a relay on the local host often wants no
# authentication, so neither may be demanded when a host is set.
SMTP_USER=
# An app-specific password, never the account password, and scoped to SMTP alone
# if the provider offers it. Then a leak of this file sends mail as you rather
# than reading your mailbox — a smaller blast radius for no extra effort.
SMTP_PASSWORD=
# The From: header, which is not the login above. Most providers reject a From
# they have not verified, and Fastmail accepts only an identity or alias on the
# account. Optional; defaults to SMTP_USER. Takes a display name:
# "Money <noreply@example.com>".
SMTP_FROM=
# Override the port-derived encryption, for a relay that disagrees with the
# convention above. "true" for implicit TLS, "false" for STARTTLS. Leave empty.
SMTP_SECURE=

# Akahu credentials — https://my.akahu.nz
# App token identifies this app; the user token grants read access to your
# accounts and transactions.
#
# This is the instance-wide pair, used by any bank link whose `tokenSource` is
# `env` — which is every link that predates phase 8, and the simplest thing that
# works for a single-user install. Because there is one pair, it can only really
# serve one workspace. A second workspace with a second person's accounts wants
# `money link token` instead (or the app's own connect-a-bank form), which stores
# a pair on the bank link itself.
AKAHU_APP_ID_TOKEN=
AKAHU_USER_ACCESS_TOKEN=

# Encrypts the Akahu tokens that `money link token` stores on a bank link
# (AES-256-GCM). Generate with `openssl rand -base64 32`. Unset is fine if every
# link uses the env pair above — nothing encrypts or decrypts until a link is
# `stored`.
#
# Two things about where it belongs. It must never live in the database it opens:
# that is what makes a leaked dump inert rather than a live banking-read (T19), so
# do not put it in a column, a seed, or a backup script. And the *web app* neither
# needs it nor gets it — only the sync worker and this CLI decrypt, so
# compose.prod.yaml blanks it on the `app` and `cron` services deliberately (the
# cron only enqueues; the worker is what opens a token). Losing it is
# survivable: re-run `money link token` per link.
TOKEN_ENCRYPTION_KEY=

# The keypair behind the app's "connect a bank" form. Generate both halves with
# `money link keypair`.
#
# The form needs the web app to *store* an Akahu token, and phase 8's whole point
# is that it must never be able to *read* one — a shape symmetric crypto does not
# have. So the app gets TOKEN_PUBLIC_KEY, which only seals, and the private half
# goes exactly where TOKEN_ENCRYPTION_KEY already is: the worker and this CLI.
# Putting TOKEN_PRIVATE_KEY on the app undoes the arrangement silently — the form
# keeps working and the internet-facing service can read every stored token again
# — which is why compose.prod.yaml, money-app.container and money-cron.container
# blank it explicitly.
#
# These supersede TOKEN_ENCRYPTION_KEY rather than sitting beside it: with a
# keypair set, `money link token` seals too, and `money link upgrade` converts the
# rows an older instance already has. Once no link reports [symmetric] in
# `money link token --list`, TOKEN_ENCRYPTION_KEY can be removed everywhere.
TOKEN_PUBLIC_KEY=
TOKEN_PRIVATE_KEY=

# --- Containers (compose.prod.yaml) only; ignored by `next dev` ---
# Compose reads these from this file to build the internal DATABASE_URL and to
# publish the app. The app container reaches Postgres at host `postgres`, so the
# DATABASE_URL above (127.0.0.1, for dev) is overridden per-service in compose.
# POSTGRES_PASSWORD has no default and must be set. APP_PORT is the host port the
# app is published on. SYNC_INTERVAL_SECONDS is how often the `cron` service
# *enqueues* a sync (default 6h) — the `worker` service is what runs it.
POSTGRES_USER=money
POSTGRES_PASSWORD=
POSTGRES_DB=money
APP_PORT=3000
SYNC_INTERVAL_SECONDS=21600

# Passwords for the two least-privileged runtime roles (phase 6, RLS). POSTGRES_USER
# above owns the schema and runs migrations; the app connects as `money_app` and
# both the cron and the worker as `money_sync`, non-owner roles that Row-Level
# Security actually applies to. The migrate step (`pnpm db:setup`) creates the roles
# and sets these passwords. No defaults — set both. Locally, `pnpm db:setup` after
# `pnpm db:up` creates them too, and the isolation test connects as money_app to
# prove RLS.
APP_DB_PASSWORD=
SYNC_DB_PASSWORD=

# Namespace for ids this app mints itself — user-created merchants and labels,
# and later custom categories and category groups. They look like
# `app_merchant_<random>`, which keeps them tellable apart from the ids mirrored
# from Akahu (`merchant_`) and NZFCC (`nzfcc_`), whose shape they would otherwise
# share.
#
# Lowercase letters and digits, no underscore (it's the separator). Optional;
# defaults to "app". Safe to change — ids are opaque and nothing parses them, so
# rows minted under an old namespace keep it and coexist.
ID_NAMESPACE=

# --- The local model (all optional) ---
# Two things in this app talk to a model and both talk to this one: the budget
# inference the worker runs headlessly, and the chat at /chat. With LLM_API unset
# the budget button still works — it falls back to the deterministic seeder — and
# /chat says no model is reachable.
#
# LOCAL ONLY. The prompt is a household's whole transaction history and it must
# not leave the machine, so the endpoint is checked for a loopback or private
# address before any request is issued and refused otherwise.
#
# An OpenAI-compatible base, e.g. 127.0.0.1:11434 for Ollama. A bare `host:port`
# is fine — the scheme is filled in and `/v1` appended.
LLM_API=
# Bearer token, only if the endpoint wants one. Ollama does not.
LLM_API_KEY=
# Which model to ask for; whatever the local runtime has pulled. Default llama3.1.
LLM_MODEL=
# Opt out of the loopback/private check above, for a deliberate remote endpoint.
# Understand what it sends before setting this: "true" to allow.
LLM_ALLOW_REMOTE=
# Per-call timeout in ms. Default 300000, clamped to 30000–600000.
LLM_TIMEOUT=
# How far back the tools may read. Default and cap are the deterministic path's
# window; clamped to 1–36 months.
LLM_MAX_MONTHS=
# Most transactions one tool result may hold — the model pages through anything
# larger. Default 400, clamped 20–10000. (LLM_MAX_WINDOW_TX is the old name and
# is still read as a fallback.)
LLM_MAX_TOOL_ROWS=
# Tool-loop rounds before a run or a chat turn is cut off. Default 150, clamped
# 4–1000. The cap exists to stop a looping model, not to bound honest work.
LLM_MAX_STEPS=
# Characters of tool output a chat still carries in context; older results are
# elided for the model only, never from the thread you can scroll back through.
# Default 60000.
LLM_CONTEXT_TOOL_BUDGET=

# --- Worker queue tuning (all optional) ---
# `pnpm worker:start` drains the SyncRun, RuleRun and BudgetInferenceRun queues.
# The defaults suit a household instance; these exist for when they don't.
#
# Short-poll interval in seconds. Default 5.
WORKER_POLL_SECONDS=
# Tries before a run is failed for good. Default 3.
WORKER_MAX_ATTEMPTS=
# Base of the exponential retry backoff, in seconds. Default 30.
WORKER_BACKOFF_SECONDS=
# Age at which a `running` row is reaped as abandoned (a worker that died
# mid-job). Default 15, deliberately well above how long a real run takes.
WORKER_STALE_MINUTES=
# How often `money sync --watch` re-reads the runs it queued. Default 2.
SYNC_WATCH_POLL_SECONDS=
