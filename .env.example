# Postgres. `pnpm db:up` starts the local one defined in compose.yaml; the
# credentials below match that service and are for local development only.
# A hosted deployment wants a pooled connection string and `sslmode=require`.
DATABASE_URL="postgresql://money:money@127.0.0.1:5432/money?schema=public"

# Auth. The secret signs session tokens: generate one with
# `openssl rand -base64 32`. There is no default and no generated fallback on
# purpose — a per-process secret would log everyone out on every restart, and
# two container replicas would never agree on a session.
#
# Rotating it invalidates every session at once, which is the break-glass move
# if a session is ever believed stolen.
BETTER_AUTH_SECRET=

# The app's own origin. Better Auth otherwise infers it from the incoming
# request, which means a `Host` header decides how same-origin is judged. Set it.
BETTER_AUTH_URL="http://localhost:3000"

# Whether TOTP enrolment is mandatory. The capability always ships; this only
# decides whether an unenrolled user is walked through enrolment before reaching
# any data. Off, the household host stays friction-free and anyone who wants a
# second factor can still turn it on. On is the posture Akahu's accreditation
# requires (see docs/multi-user.md). "true" to enforce; anything else is off.
REQUIRE_MFA=

# Akahu credentials — https://my.akahu.nz
# App token identifies this app; the user token grants read access to your
# accounts and transactions.
AKAHU_APP_ID_TOKEN=
AKAHU_USER_ACCESS_TOKEN=

# Namespace for ids this app mints itself — user-created merchants, and later
# custom categories and category groups. They look like `app_merchant_<random>`,
# which keeps them tellable apart from the ids mirrored from Akahu (`merchant_`)
# and NZFCC (`nzfcc_`), whose shape they would otherwise share.
#
# Lowercase letters and digits, no underscore (it's the separator). Optional;
# defaults to "app". Safe to change — ids are opaque and nothing parses them, so
# rows minted under an old namespace keep it and coexist.
ID_NAMESPACE=
