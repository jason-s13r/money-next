# Local SQLite database.
# The better-sqlite3 driver adapter strips the `file:` prefix and resolves the
# rest against the current working directory, so always run from the repo root.
DATABASE_URL="file:./money.db"

# Akahu credentials — https://my.akahu.nz
# App token identifies this app; the user token grants read access to your accounts.
AKAHU_APP_ID_TOKEN=
AKAHU_USER_ACCESS_TOKEN=
