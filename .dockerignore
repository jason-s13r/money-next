# Everything the build does not need. node_modules especially: it is
# reinstalled inside the linux image so the linux zen-engine prebuild is the one
# that lands, never the host's darwin binary.
node_modules
.next
.git
.github

# Secrets never enter an image layer. Runtime env comes from the compose
# env_file / environment at `docker compose up`, not from a baked-in file.
.env
.env.*

# Personal financial data — must never be copied into an image.
*.db
*.db.*
*.db-journal
*.db-wal
*.db-shm
classify.rules.json

# Local-only and non-source.
.DS_Store
.claude
.pnpm-store
docs
tests
*.tsbuildinfo
*.log
Dockerfile
.dockerignore
compose.yaml
compose.prod.yaml
README.md
